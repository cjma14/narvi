---
interface Props {
  country: "us" | "ve" | "pa";
  label?: string;
}

const { country, label } = Astro.props as Props;

const ariaLabel =
  label ??
  (country === "us"
    ? "United States flag"
    : country === "ve"
      ? "Venezuela flag"
      : "Panama flag");
---

<span class="inline-flex h-8 w-8 shrink-0 overflow-hidden rounded-md border border-white/15 bg-neutral-950 shadow-sm" aria-label={ariaLabel} role="img">
  {country === "us" && (
    <svg viewBox="0 0 64 48" class="h-full w-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="64" height="48" fill="#ffffff" />
      <g fill="#b91c1c">
        <rect y="0" width="64" height="4" />
        <rect y="8" width="64" height="4" />
        <rect y="16" width="64" height="4" />
        <rect y="24" width="64" height="4" />
        <rect y="32" width="64" height="4" />
        <rect y="40" width="64" height="4" />
      </g>
      <rect width="28" height="24" fill="#1d4ed8" />
      <g fill="#ffffff">
        <circle cx="5" cy="4" r="1.2" />
        <circle cx="11" cy="4" r="1.2" />
        <circle cx="17" cy="4" r="1.2" />
        <circle cx="23" cy="4" r="1.2" />
        <circle cx="8" cy="10" r="1.2" />
        <circle cx="14" cy="10" r="1.2" />
        <circle cx="20" cy="10" r="1.2" />
        <circle cx="5" cy="16" r="1.2" />
        <circle cx="11" cy="16" r="1.2" />
        <circle cx="17" cy="16" r="1.2" />
        <circle cx="23" cy="16" r="1.2" />
      </g>
    </svg>
  )}

  {country === "ve" && (
    <svg viewBox="0 0 64 48" class="h-full w-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="64" height="16" y="0" fill="#facc15" />
      <rect width="64" height="16" y="16" fill="#1d4ed8" />
      <rect width="64" height="16" y="32" fill="#dc2626" />
      <g fill="#ffffff">
        <circle cx="20" cy="20" r="1.6" />
        <circle cx="26" cy="18" r="1.6" />
        <circle cx="32" cy="17" r="1.6" />
        <circle cx="38" cy="18" r="1.6" />
        <circle cx="44" cy="20" r="1.6" />
        <circle cx="35" cy="23" r="1.6" />
        <circle cx="29" cy="23" r="1.6" />
      </g>
    </svg>
  )}

  {country === "pa" && (
    <svg viewBox="0 0 64 48" class="h-full w-full" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect width="32" height="24" x="0" y="0" fill="#ffffff" />
      <rect width="32" height="24" x="32" y="0" fill="#dc2626" />
      <rect width="32" height="24" x="0" y="24" fill="#1d4ed8" />
      <rect width="32" height="24" x="32" y="24" fill="#ffffff" />
      <path fill="#1d4ed8" d="M16 5l1.5 4.6H22l-3.8 2.8 1.5 4.6L16 14.2l-3.7 2.8 1.4-4.6L10 9.6h4.5z" />
      <path fill="#dc2626" d="M48 29l1.5 4.6H54l-3.8 2.8 1.5 4.6L48 38.2l-3.7 2.8 1.4-4.6L42 33.6h4.5z" />
    </svg>
  )}
</span>