---
import Icon from "@components/ui/icons/Icon.astro";
// Destructure the properties from Astro.props
const { title, url, noArrow } = Astro.props;
// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
  noArrow?: boolean;
}
// Define CSS classes for styling the button
const baseClasses =
  "group inline-flex items-center justify-center gap-x-2 rounded-lg px-8 py-4 text-lg font-bold text-neutral-50 ring-zinc-500 transition-all duration-300 focus-visible:ring outline-none hover:cursor-pointer shadow-[0_0_15px_rgba(159,196,35,0.3)] hover:shadow-[0_0_25px_rgba(159,196,35,0.5)]";
const borderClasses = "border border-transparent";
const bgColorClasses =
  "bg-primary-500 hover:bg-primary-600 active:bg-primary-500 dark:focus:outline-none";
const disableClasses = "disabled:pointer-events-none disabled:opacity-50";
const fontSizeClasses = "2xl:text-lg";
const ringClasses = "dark:ring-zinc-200";
---

<!-- Link styled as a button, with dynamic title, URL, and optional arrow -->
<a
  class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${disableClasses} ${fontSizeClasses} ${ringClasses}`}
  href={url}
>
  {title}
  <!-- Display the arrow based on the 'noArrow' property -->

  {noArrow ? null : <Icon name="arrowRight" />}
</a>
