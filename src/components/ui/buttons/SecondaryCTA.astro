---
// Destructure the properties from Astro.props
const { title, url } = Astro.props;

// Define TypeScript interface for the properties
interface Props {
  title?: string;
  url?: string;
}
// Define CSS classes for the hyperlink button
const baseClasses =
  "inline-flex items-center justify-center gap-x-2 rounded-lg px-8 py-4 text-center text-lg font-bold text-white shadow-sm outline-none ring-zinc-500 focus-visible:ring transition-all duration-300";
const borderClasses = "border-2 border-white";
const bgColorClasses = "bg-transparent";
const hoverClasses =
  "hover:border-primary-400 hover:text-primary-400";
const disableClasses = "disabled:pointer-events-none disabled:opacity-50";
const fontSizeClasses = "2xl:text-lg";
const ringClasses = "ring-zinc-500";
---

<!-- Styled hyperlink -->
<a
  class={`${baseClasses} ${borderClasses} ${bgColorClasses} ${hoverClasses} ${disableClasses} ${fontSizeClasses} ${ringClasses}`}
  href={url}
>
  {title}
</a>
