---
// Import the necessary dependencies
import FooterSocialLink from "@components/ui/links/FooterSocialLink.astro";
import enStrings from "@utils/navigation.ts";
import esStrings from "@utils/es/navigation.ts";
import Icon from "@components/ui/icons/Icon.astro";
import BrandLogo from "@components/BrandLogo.astro";
import { SITE } from "@data/constants";

// Select the correct translation based on the page's lang prop:
const strings = Astro.currentLocale === "es" ? esStrings : enStrings;

// Define the variables that will be used in this component
const companyDescription: string =
  Astro.currentLocale === "es" 
    ? "Liderando la nueva era energética con servicios avanzados de intervención a pozos."
    : "Leading the new energy era with advanced well intervention services.";

const privacyPolicy: string = 
  Astro.currentLocale === "es" ? "Política de Privacidad" : "Privacy Policy";

const termsOfService: string = 
  Astro.currentLocale === "es" ? "Términos de Servicio" : "Terms of Service";
---

<footer class="w-full bg-black text-pearl-100">
  <div
    class="mx-auto w-full max-w-[85rem] px-4 py-10 sm:px-6 lg:px-16 lg:pt-16 lg:pb-8 2xl:max-w-screen-2xl"
  >
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-4 lg:gap-12">
      <!-- Column 1: Logo, Description, and Social Links -->
      <div class="col-span-1 lg:col-span-1">
        <BrandLogo class="h-auto w-32" />
        <p class="text-sm text-gray-500 mb-6 max-w-xs leading-relaxed mt-4">
          {companyDescription}
        </p>
        
        <!-- Social Media Icons -->
        <div class="flex gap-3">
          <FooterSocialLink url="https://www.linkedin.com/company/narvi-enterprise/">
            <Icon name="linkedin" />
          </FooterSocialLink>
          <FooterSocialLink url="https://www.instagram.com/narvi_ec?igsh=OHk0c3FxdTVhcnN6&igsi=OHk0c3FxdTVhcnN6">
            <Icon name="instagram" />
          </FooterSocialLink>
        </div>
      </div>

      <!-- Columns 2-4: Footer Links from navigation -->
      {
        strings.footerLinks.map((section) => (
          <div class="col-span-1">
            <h3 class="font-bold text-pearl-100 mb-4 text-base">{section.section}</h3>
            <ul class="space-y-3">
              {section.links.map((link) => (
                <li>
                  {link.type === "url" ? (
                    <a
                      href={link.url}
                      class="inline-flex items-center gap-x-2 text-sm text-gray-500 rounded-lg outline-none ring-zinc-500 transition duration-300 hover:text-pearl-100 focus-visible:ring"
                    >
                      {link.icon && <Icon name={link.icon} classCustom="h-4 w-4" />}
                      {link.name}
                    </a>
                  ) : (
                    <span class="inline-flex items-center gap-x-2 text-sm text-gray-500">
                      {link.icon && <Icon name={link.icon} classCustom="h-4 w-4" />}
                      {link.name}
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <!-- Footer Bottom: Copyright and Links -->
    <div class="mt-12 pt-8 border-t border-neutral-800">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-gray-500">
        <p>
          © <span id="current-year"></span> NARVI Enterprise Corporation. {Astro.currentLocale === "es" ? "Todos los derechos reservados." : "All rights reserved."}
        </p>
        
        <div class="flex gap-6">
          <a 
            href={Astro.currentLocale === "es" ? "/es/privacy" : "/privacy"} 
            class="transition duration-300 hover:text-pearl-100"
          >
            {privacyPolicy}
          </a>
          <a 
            href={Astro.currentLocale === "es" ? "/es/terms" : "/terms"} 
            class="transition duration-300 hover:text-pearl-100"
          >
            {termsOfService}
          </a>
        </div>
      </div>
    </div>

    <script>
      const year = new Date().getFullYear();
      const element = document.getElementById("current-year");
      element!.innerText = year.toString();
    </script>
  </div>
</footer>

<a
  href="https://wa.me/584127832848"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={Astro.currentLocale === "es" ? "Contactar por WhatsApp" : "Contact via WhatsApp"}
  class="fixed bottom-5 right-5 z-50 inline-flex items-center gap-2 rounded-full bg-[#25D366] px-4 py-3 text-sm font-semibold text-white shadow-lg transition hover:scale-[1.03] hover:brightness-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/90"
>
  <Icon name="phone" classCustom="h-4 w-4 fill-white" />
  <span>{Astro.currentLocale === "es" ? "WhatsApp" : "WhatsApp"}</span>
</a>
