---
import Icon from "@components/ui/icons/Icon.astro";

interface SolutionItem {
  title: string;
  description: string;
  bullets: string[];
  image: string;
  imageAlt: string;
  iconName?: string; // Icon name from icons.ts
}

interface Props {
  sectionLabel: string;
  title: string;
  subTitle: string;
  solutions: SolutionItem[];
  ctaLabel?: string;
  ctaUrl?: string;
}

const { sectionLabel, title, subTitle, solutions, ctaLabel, ctaUrl = "/contact" } = Astro.props;
---

<section id="solutions" class="mx-auto max-w-screen-2xl px-4 py-14 sm:px-6 lg:px-8 lg:py-20">
  <div class="fade-up">
    <!-- <div class="mb-4 flex items-center gap-3">
      <span class="h-[10px] w-[10px] rounded-full bg-primary-500"></span>
      <p class="text-lg font-bold text-pearl-100">{sectionLabel}</p>
    </div> -->

    <div class="mb-12 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div class="max-w-3xl">
        <h2 class="text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight">
          {title}
        </h2>
        <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
          {subTitle}
        </p>
      </div>

      {ctaLabel && (
        <a
          href={ctaUrl}
          class="group inline-flex items-center justify-center gap-x-2 rounded-lg border border-transparent bg-primary-500 px-8 py-4 text-lg font-bold text-neutral-50 shadow-[0_0_15px_rgba(159,196,35,0.3)] ring-zinc-500 transition-all duration-300 hover:cursor-pointer hover:bg-primary-600 hover:shadow-[0_0_25px_rgba(159,196,35,0.5)] focus-visible:ring active:bg-primary-500 disabled:pointer-events-none disabled:opacity-50 dark:focus:outline-none dark:ring-zinc-200"
        >
          {ctaLabel}
          <svg class="h-5 w-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      )}
    </div>
  </div>

  <div class="grid gap-6 md:grid-cols-2 2xl:grid-cols-3">
    {solutions.map((item, index) => (
      <article class="group overflow-hidden rounded-2xl border border-primary-500/25 bg-[#14332d] shadow-lg transition duration-300 hover:-translate-y-1 hover:border-primary-500/60">
        <div class="relative h-48 overflow-hidden bg-[#0f2722]">
          <img
            src={item.image}
            alt={item.imageAlt}
            loading={index === 0 ? "eager" : "lazy"}
            class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
          />
        </div>

        <div class="relative p-8">
          <span class="absolute -top-5 right-8 inline-flex h-11 w-11 items-center justify-center rounded-full bg-primary-500 text-neutral-900 shadow-[0_8px_20px_rgba(159,196,35,0.35)]">
            {item.iconName ? (
              <Icon name={item.iconName} />
            ) : (
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7 5h10a2 2 0 012 2v10a2 2 0 01-2 2H7a2 2 0 01-2-2V7a2 2 0 012-2z"></path>
              </svg>
            )}
          </span>

          <h3 class="text-2xl font-bold text-pearl-100">{item.title}</h3>
          <p class="mt-3 text-pearl-100/75">{item.description}</p>

          <ul class="mt-6 space-y-3">
            {item.bullets.map((bullet) => (
              <li class="flex items-start gap-3 text-pearl-100/90">
                <svg class="mt-1 h-5 w-5 flex-shrink-0 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </div>
      </article>
    ))}
  </div>
</section>
