---
interface Partner {
  src: string;
  alt: string;
}

interface Props {
  title: string;
  partners: Partner[];
}

const { title, partners } = Astro.props;
---

<div id="tech-partners" class="border-y border-pearl-100/5 bg-neutral-900/40 px-4 sm:px-6 lg:px-8">
  <section class="mx-auto max-w-screen-2xl py-12 sm:py-16 lg:py-20">
    <div class="mx-auto mb-10 flex w-full flex-col items-center text-center">
      <h2
        class="text-balance text-2xl font-bold leading-tight text-pearl-100 sm:text-3xl md:text-4xl"
      >
        <Fragment set:html={title} />
      </h2>
    </div>

    <div class="swiper swiperTechPartners w-full overflow-hidden">
      <div class="swiper-wrapper flex items-center justify-center">
        {
          partners.map((partner) => (
            <div class="swiper-slide slide-brand flex justify-center py-2">
              <div class="bg-neutral-950/40 border-neutral-800 hover:border-primary-400/40 hover:bg-neutral-900/60 flex h-40 w-64 items-center justify-center rounded-2xl border px-6 py-4 shadow-sm transition-all duration-500 hover:shadow-primary-400/5 hover:scale-105">
                <img
                  class="h-full w-full object-contain filter brightness-95 grayscale opacity-75 transition-all duration-500 hover:grayscale-0 hover:opacity-100 hover:brightness-110"
                  src={partner.src}
                  alt={partner.alt}
                  loading="lazy"
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</div>

<style>
  .swiper-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .swiper-slide {
    width: auto !important;
  }
</style>

<script>
  import Swiper from "swiper";
  import { Autoplay } from "swiper/modules";

  const swiperElement = document.querySelector(".swiperTechPartners");
  if (swiperElement) {
    const slideCount = swiperElement.querySelectorAll(".swiper-slide").length;

    new Swiper(".swiperTechPartners", {
      modules: [Autoplay],
      slidesPerView: "auto",
      spaceBetween: 24,
      centeredSlides: false,
      watchOverflow: true,
      breakpoints: {
        640: {
          spaceBetween: 32,
        },
        1024: {
          spaceBetween: 40,
        },
      },
      autoplay: slideCount > 4 ? {
        delay: 4000,
        disableOnInteraction: false,
      } : false,
    });
  }
</script>
