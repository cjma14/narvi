---
// Import the required modules
import PrimaryCTA from "@components/ui/buttons/PrimaryCTA.astro";
// Extract properties from Astro.props
const {
  title,
  subTitle,
  label,
  btnExists,
  btnTitle,
  btnURL,
  videoUrl,
} = Astro.props;
// Define TypeScript interface for the properties
interface Props {
  title: string;
  subTitle: string;
  label: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  videoUrl?: string;
}

const infoTitle1 = Astro.currentLocale === "es" ? "Clientes Globales" : "Global Clients";
const infoTitle2 = Astro.currentLocale === "es" ? "Grandes Proyectos" : "Major Projects";

// Extract YouTube ID from URL
const getYouTubeId = (url: string) => {
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/;
  const match = url?.match(regExp);
  return (match && match[2].length === 11) ? match[2] : null;
};

const youtubeId = videoUrl ? getYouTubeId(videoUrl) : null;
---

<!-- Root section of the component -->
<div class="px-4 sm:px-6 lg:px-8 border-pearl-100/10 bg-neutral-900/30">
  <section
    class="mx-auto max-w-screen-2xl items-center gap-16 px-4 py-10 text-pearl-100 sm:px-6 lg:grid lg:grid-cols-2 lg:px-8 lg:py-20"
  >
    <div class="fade-up">
      <!-- Title of the section -->
      <!-- <div class="mb-4 flex items-center gap-3">
        <span class="flex h-[10px] w-[10px] rounded-full bg-primary-500"></span>
        <h3 class="text-lg font-bold text-pearl-100 drop-shadow-xl">{label}</h3>
      </div> -->

      <h2 class="mb-4 text-balance text-4xl font-extrabold tracking-tight">
        {title}
      </h2>
      <!-- Subtitle of the section -->
      <p
        class="mb-4 max-w-prose text-pretty font-light dark:text-neutral-400 sm:text-lg"
      >
        {subTitle}
      </p>

      <div class="mb-16 mt-16 flex gap-10">
        <div class="">
          <p class="mb-3 text-5xl font-bold sm:text-5xl">35+</p>
          <p class="text-xl">{infoTitle1}</p>
        </div>
        <div class="md:border-l md:pl-10">
          <p class="mb-3 border-l-primary-400 text-5xl font-bold sm:text-5xl">
            50+
          </p>
          <p class="text-xl">{infoTitle2}</p>
        </div>
      </div>
      <!-- Conditional rendering of the Primary Call-To-Action button if 'btnExists' is true -->
      {btnExists ? <PrimaryCTA title={btnTitle} url={btnURL} /> : null}
    </div>
    <!-- Video Player with Plyr -->
    {youtubeId && (
      <div class="mt-8">
        <div class="fade-up relative w-full">
          <div 
            id="player-about" 
            data-plyr-provider="youtube" 
            data-plyr-embed-id={youtubeId}
            class="absolute inset-0 h-full w-full"
          ></div>
        </div>
      </div>
    )}
  </section>
</div>

<script>
  import Plyr from 'plyr';
  import 'plyr/dist/plyr.css';

  const playerAbout = new Plyr('#player-about', {
    controls: ['play-large', 'play', 'progress', 'current-time', 'mute', 'volume', 'fullscreen'],
  });
</script>
