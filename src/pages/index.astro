---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import SolutionsEcosystemSection from "@components/sections/landing/SolutionsEcosystemSection.astro";
import HeroSectionAlt from "@components/sections/landing/HeroSectionAlt.astro";
import ClientsSection from "@components/sections/landing/ClientsSection.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import ProductsSection from "@components/sections/landing/ProductsSection.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
import faqs from "@data/faqs.json";
import avatar from "@images/avatar.jpg";
import AboutUsSection from "@/components/sections/AboutUsSection.astro";
import BannerSection from "@/components/sections/BannerSection.astro";
import TeleprompterSection from "@/components/sections/landing/TeleprompterSection.astro";
import TechPartnersSection from "@components/sections/landing/TechPartnersSection.astro";
import ProjectConsultationSection from "@components/sections/landing/ProjectConsultationSection.astro";
import features from "@data/features.json";
import productsIcons from "@data/products-icons.json";

const avatarSrcs: Array<string> = [avatar.src];

const solutionsSection = {
  sectionLabel: "Solutions Ecosystem",
  title: "Solutions That Power Your Operations",
  subTitle: '"When your operations can\'t stop, we respond"',
  ctaLabel: "Request Catalog",
  ctaUrl: "/contact",
  solutions: [
     {
      title: "Well Services",
      description:
        "Comprehensive technical solutions for well intervention, maintenance, and optimization to maximize reservoir productivity.",
      bullets: ["Maintenance and workover", "Monitoring and optimization"],
      image: "/img/service24.avif",
      imageAlt: "Oil and gas plant for well services operations",
      iconName: "building",
    },
    {
      title: "Industrial Transport",
      description:
        "Industrial trucks and logistics solutions for the safe movement of oilfield equipment, ensuring operational continuity.",
      bullets: ["Heavy-duty trucks", "Strategic logistics"],
      image: "/img/service26.avif",
      imageAlt: "Industrial transport vehicle for oilfield logistics",
      iconName: "truck",
    },
    {
      title: "Spare Parts and Support",
      description:
        "Supply of critical industrial parts that reduce downtime and maintain your machinery at peak performance.",
      bullets: ["Critical components", "Dedicated support"],
      image: "/img/service28.avif",
      imageAlt: "Technical work for spare parts and industrial support",
      iconName: "sliders",
    },
     {
      title: "Heavy Machinery",
      description:
        "Supply of certified new and used equipment, designed for high-performance operations in the Oil & Gas industry.",
      bullets: ["Drilling equipment", "Pumping systems"],
      image: "/img/service25.avif",
      imageAlt: "Heavy machinery for oil and gas operations",
      iconName: "gearSettings",
    },
  ],
};
---

<MainLayout
  lang="en"
  title="NARVI Enterprise Corporation | Equipos y Servicios para Petróleo, Gas e Industria"
  meta="NARVI Enterprise Corporation - Proveedor líder de equipos, repuestos y soluciones para la industria energética e industrial (Oil & Gas). Más de 25 años de experiencia en Norteamérica y Latinoamérica."
>
  <!-- <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Explore ScrewFast on GitHub"
    url="https://github.com/mearashadowfax/ScrewFast"
  /> -->

  <HeroSection
    title=`Do you need <span class='text-primary-400'>reliable equipment</span>?`
    subTitle="At Narvi Enterprise Corporation, we supply heavy machinery, industrial trucks, and specialized logistics for the energy sector across North and Latin America."
    primaryBtn="Quote Now"
    primaryBtnURL="/contact"
    secondaryBtn="Explore Solutions"
    secondaryBtnURL="#solutions"
    withReview={false}
  />

  <SolutionsEcosystemSection
    sectionLabel={solutionsSection.sectionLabel}
    title={solutionsSection.title}
    subTitle={solutionsSection.subTitle}
    ctaLabel={solutionsSection.ctaLabel}
    ctaUrl={solutionsSection.ctaUrl}
    solutions={solutionsSection.solutions}
  />
 
  <AboutUsSection
    label="About Us"
    title="Engineering & Asset Management for the Oil & Gas Industry"
    subTitle="With over 25 years of international experience, we specialize in maximizing equipment reliability and operational efficiency. From North America to Latin America, we provide world-class project engineering and specialized equipment supply."
    videoUrl="https://youtu.be/dyiQqlkigkE"
    btnExists={true}
    btnTitle="View Our Solutions"
    btnURL="/sales"
  />


  <!-- <TeleprompterSection
    text="With over 25 years of experience in the Oil and Gas sector, asset management, maintenance, and equipment reliability at an international level, in North American and Latin American countries. We have focused on providing professional services in the engineering of equipment projects, their commercialization, and supply. Our priority is efficiency in every project, we accompany your business goals with innovation and sustainability."
    title="Miguel Mogollón"
    subTitle="CEO and Founder"
  /> -->

  <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <ClientsSection
      label="Our Clients"
      title="Some of the companies that trust us"
      subTitle="Leaders trust in our products and services"
    />

    <TestimonialsSection
      label=""
      title="Discover how we work"
      subTitle='Want to know why so many companies trust us? Discover the benefits of working with Narvi through our customer testimonials.'
      videoUrl="https://youtu.be/kXDREldf7b8"
      testimonials={[
        {
          content:
            '"Working with Narvi has transformed our efficiency. Their team sustains our logistics."',
          author: "Chief Engineer",
          role: "Chief Engineer @Petroalliance",
          avatarSrc: "/img/clients/testimonial-4.jpeg",
        },
      ]}
    />
  </div>

  <TechPartnersSection
      title='Driving the industry with <span class="text-primary-400">Innovation</span>'
      partners={[
        { name: "TECHCORE", icon: "cpu", color: "text-primary-400" },
        { name: "SECURE RIG", icon: "shield-check", color: "text-primary-500" },
        { name: "GLOBAL LOGISTICS", icon: "globe", color: "text-primary-400" },
        { name: "POWER SYSTEMS", icon: "zap", color: "text-primary-500" },
      ]}
    />

  <ProjectConsultationSection
    mainTitle="Your Project Deserves"
    mainTitleHighlight="Operational Certainty"
    mainSubtitle="In high-demand energy environments, the right supplier makes the difference. We are ready to support your next growth phase."
    benefit1="Priority response in less than 24 hours."
    benefit2="Availability and clear technical specifications."
    benefit3="Absolute confidentiality treatment."
    formTitle="Request Information Today"
    formSubtitle="Tell us what your project needs and our industrial team will send you commercial options shortly."
    formLabels={{
      fullName: "Full Name",
      fullNamePlaceholder: "e.g. John Doe",
      company: "Company",
      companyPlaceholder: "Your company name",
      email: "Email",
      emailPlaceholder: "email@company.com",
      phone: "Phone",
      phonePlaceholder: "+1 (555) 000-0000",
      serviceRequired: "Equipment or Service Required",
      serviceRequiredPlaceholder: "Select an option",
      projectLocation: "Project Location",
      projectLocationPlaceholder: "Country / Region",
      submitButton: "Send Request"
    }}
    serviceOptions={[
      { value: "heavy-machinery", label: "Heavy Machinery" },
      { value: "industrial-transport", label: "Industrial Transport" },
      { value: "spare-parts", label: "Spare Parts & Support" },
      { value: "well-services", label: "Well Services" },
      { value: "project-consulting", label: "Project Consulting" },
      { value: "other", label: "Other" }
    ]}
    successMessage={{
      title: "We have received your request!",
      description: "Thank you for contacting us. We will get back to you shortly."
    }}
  />
</MainLayout>
