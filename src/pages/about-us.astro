---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import FlagIcon from "@components/ui/FlagIcon.astro";

// Import necessary images
import { SITE } from "@data/constants";

interface aboutItem {
  id?: string;
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
  items?: string[];
}

const aboutItems: aboutItem[] = [
  {
    id: "mision",
    isRightSection: false,
    title: "Mission",
    subTitle:
      "Provide excellent service to all our clients, ensuring that their expectations are met and exceeded.",
    img: "/img/mission.jpg",
    imgAlt: "Narvi's staff offering advice",
    btnExists: false,
  },
  {
    id: "vision",
    isRightSection: false,
    title: "Vision",
    subTitle:
      "To be a company recognized nationally and internationally for the excellent management of services and products that we provide to our clients, with responsibility and efficiency in each project.",
    img: "/img/vision.jpg",
    imgAlt: "Cargo of equipment for sale in Narvi arriving at the port",
    btnExists: false,
  },
  {
    isRightSection: true,
    title: "VALUES",
    subTitle:
      "Our team is made up of highly trained professionals who share our passion for their work. We work together to achieve excellence in everything we do, hand in hand with the following values:",
    single: false,
    imgOne: "/img/values1.jpg",
    imgOneAlt: "Engineer Narvi doing his job",
    imgTwo: "/img/values2.jpg",
    imgTwoAlt: "Narvi's engineer supervising an operation",
    items: [
      "Commitment",
      "Responsibility",
      "Efficiency",
      "Professionalism",
      "Integrity",
    ],
  },
];

const pageTitle: string = `About us | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://narvi-ec.com/about-us",
    url: "https://narvi-ec.com/about-us",
    name: "About us | Narvi EC",
    description: "",
    isPartOf: {
      "@type": "WebSite",
      url: "https://narvi-ec.com",
      name: "Narvi Enterprise Corporation",
      description:
        "Narvi EC offers engineering and maintenance services throughout the Americas, optimizing your operations in the energy sector.",
    },
    inLanguage: "en-US",
  }}
>
  <!--MainSection is the introductory section of the page, it also contains a CTA button-->
  <MainSection
    label="About us"
    title="A reliable ally in the oil and gas industry"
    backgroundImg="/img/backgorund3.jpg"
  />

  <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <section class="relative py-16">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-10 text-center">
          <span class="text-primary-400 text-mg font-bold uppercase tracking-widest">
            Key Capabilities
          </span>
          <h2 class="mt-1 text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight">
            Pillars of Operational Excellence
          </h2>
          <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
            Behind every field operation, we combine more than 30 years of
            technical experience with cutting-edge technology to drive the
            Oil & Gas sector with maximum precision and safety. At Narvi
            Enterprise Corporation, we bring operational excellence and
            technical support to every project.
          </p>
        </div>

        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div class="glass-card border-primary-800 hover:border-primary-400 group rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1">
            <div class="bg-neutral-900 border-primary-800 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-5 flex h-12 w-12 items-center justify-center rounded-xl border transition-all">
              <span class="material-symbols-outlined mi text-current text-[20px] transition-colors group-hover:text-white">construction</span>
            </div>
            <h3 class="group-hover:text-primary-400 mb-2 text-md font-bold uppercase tracking-wider text-white transition-colors">
              Advanced Services
            </h3>
            <p class="text-neutral-400 text-sm leading-relaxed">
              Specialized well intervention and production services with
              cutting-edge technology.
            </p>
          </div>

          <div class="glass-card border-primary-800 hover:border-primary-400 group rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1">
            <div class="bg-neutral-900 border-primary-800 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-5 flex h-12 w-12 items-center justify-center rounded-xl border transition-all">
              <span class="material-symbols-outlined mi text-current text-[20px] transition-colors group-hover:text-white">emoji_events</span>
            </div>
            <h3 class="group-hover:text-primary-400 mb-2 text-md font-bold uppercase tracking-wider text-white transition-colors">
              Technical Track Record
            </h3>
            <p class="mb-2 text-md font-semibold uppercase tracking-wider text-white">
              
            </p>
            <p class="text-neutral-400 text-sm leading-relaxed">
              30 years of accumulated experience in high-complexity international
              operations.
            </p>
          </div>

          <div class="glass-card border-primary-800 hover:border-primary-400 group rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1">
            <div class="bg-neutral-900 border-primary-800 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-5 flex h-12 w-12 items-center justify-center rounded-xl border transition-all">
              <span class="material-symbols-outlined mi text-current text-[20px] transition-colors group-hover:text-white">verified_user</span>
            </div>
            <h3 class="group-hover:text-primary-400 mb-2 text-md font-bold uppercase tracking-wider text-white transition-colors">
              Integrated QHSE Management
            </h3>
            <p class="text-neutral-400 text-sm leading-relaxed">
              Strict international standards in Quality, Health, Safety, and
              Environment.
            </p>
          </div>

          <div class="glass-card border-primary-800 hover:border-primary-400 group relative overflow-hidden rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1">
            <div class="bg-primary-400/20 text-primary-400 absolute right-2 top-2 rounded px-2 py-0.5 text-[10px] font-bold">
              TECH
            </div>
            <div class="bg-neutral-900 border-primary-800 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-5 flex h-12 w-12 items-center justify-center rounded-xl border transition-all">
              <span class="material-symbols-outlined mi text-current text-[20px] transition-colors group-hover:text-white">settings</span>
            </div>
            <h3 class="group-hover:text-primary-400 mb-2 text-md font-bold uppercase tracking-wider text-white transition-colors">
              AI + GPS Monitoring
            </h3>
            <p class="text-neutral-400 text-sm leading-relaxed">
              Real-time control and smart telemetry for critical assets and
              operations.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section class="py-20 relative rounded-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <h2 class="text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight">
            Strategic Foundations
          </h2>
          <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
            The corporate engine that guides our decisions and commercial
            relationships worldwide.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
          <div class="glass-card p-8 rounded-3xl relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary-400/5 rounded-full blur-2xl group-hover:bg-primary-400/15 transition-all"></div>
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-primary-400 text-slate-950 flex items-center justify-center text-2xl font-bold shadow-lg">
                <span class="material-symbols-outlined mi text-[22px]">track_changes</span>
              </div>
              <div>
                <span class="text-xs font-bold text-primary-400 uppercase tracking-widest">Purpose</span>
                <h3 class="text-2xl font-bold text-white">Mission</h3>
              </div>
            </div>
            <p class="text-pearl-100 text-base leading-relaxed">
              To be strategic allies in project development and sustainable
              growth, providing integrated solutions for our clients business
              success.
            </p>
          </div>

          <div class="glass-card p-8 rounded-3xl relative overflow-hidden group">
            <div class="absolute top-0 right-0 w-32 h-32 bg-primary-400/5 rounded-full blur-2xl group-hover:bg-primary-400/15 transition-all"></div>
            <div class="flex items-center gap-4 mb-6">
              <div class="w-12 h-12 rounded-2xl bg-primary-400 text-slate-950 flex items-center justify-center text-2xl font-bold shadow-lg">
                <span class="material-symbols-outlined mi text-[22px]">visibility</span>
              </div>
              <div>
                <span class="text-xs font-bold text-primary-400 uppercase tracking-widest">Future</span>
                <h3 class="text-2xl font-bold text-white">Vision</h3>
              </div>
            </div>
            <p class="text-pearl-100 text-base leading-relaxed">
              To be a regional benchmark in the transition toward a more
              efficient, sustainable, and technologically advanced energy
              industry.
            </p>
          </div>
        </div>

        <div class="glass-card p-8 rounded-3xl">
          <div class="text-center mb-8">
            <h3 class="text-2xl font-bold text-white">Our Corporate Values</h3>
            <p class="text-md text-neutral-400 mt-1">
              The unwavering principles of every member of the Narvi team
            </p>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
            <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-4 rounded-xl text-center group transition-all">
              <span class="material-symbols-outlined mi text-primary-400 text-[20px] mb-2 group-hover:scale-110 transition-transform inline-block">handshake</span>
              <h4 class="text-sm font-bold text-white">Reliability</h4>
            </div>

            <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-4 rounded-xl text-center group transition-all">
              <span class="material-symbols-outlined mi text-primary-400 text-[20px] mb-2 group-hover:scale-110 transition-transform inline-block">lightbulb</span>
              <h4 class="text-sm font-bold text-white">Innovation</h4>
            </div>

            <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-4 rounded-xl text-center group transition-all">
              <span class="material-symbols-outlined mi text-primary-400 text-[20px] mb-2 group-hover:scale-110 transition-transform inline-block">domain</span>
              <h4 class="text-sm font-bold text-white">Commitment</h4>
            </div>

            <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-4 rounded-xl text-center group transition-all">
              <span class="material-symbols-outlined mi text-primary-400 text-[20px] mb-2 group-hover:scale-110 transition-transform inline-block">gavel</span>
              <h4 class="text-sm font-bold text-white">Responsibility</h4>
            </div>

            <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-4 rounded-xl text-center group transition-all col-span-2 sm:col-span-1">
              <span class="material-symbols-outlined mi text-primary-400 text-[20px] mb-2 group-hover:scale-110 transition-transform inline-block">eco</span>
              <h4 class="text-sm font-bold text-white">Sustainability</h4>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="ecosystem" class="pt-5 pb-20 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900 text-primary-400 text-xs font-semibold uppercase mb-3 border border-primary-800">
              <span class="material-symbols-outlined mi text-[16px]">public</span>
              Strategic Presence
            </div>
            <h2 class="text-3xl sm:text-4xl font-black text-white">
              Narvi Ecosystem
            </h2>
          </div>
            <p class="text-pretty text-pearl-100/85 md:text-lg max-w-md mt-4 md:mt-0">
            Internationally connected infrastructure to ensure fast response
            and uninterrupted logistical support.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <div class="glass-card rounded-3xl p-8 border border-primary-800 hover:border-primary-400 transition-all duration-300 relative group overflow-hidden">
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-3">
                <FlagIcon country="us" />
                <div>
                  <h3 class="text-2xl font-bold text-white">USA</h3>
                  <span class="text-white text-sm">NARVI ENTERPRISE CORPORATION LLC</span>
                </div>
              </div>
              <span class="absolute top-0 right-0 mt-3 mr-3 px-3 py-1 rounded-full bg-neutral-900 text-primary-400 text-xs font-bold border border-primary-800">
                Logistics Hub
              </span>
            </div>

            <div class="space-y-4">
              <div class="p-4 rounded-2xl bg-neutral-950/80 border border-primary-800">
                <h4 class="text-xs font-bold uppercase text-primary-400 mb-1">Operational Role</h4>
                <p class="text-sm font-semibold text-white">
                  Main center for supply chain management.
                </p>
              </div>
              <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                Ensures procurement, quality control, and import of heavy,
                highly specialized technical equipment for all subsidiaries.
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-primary-800/50 flex items-center justify-between text-xs text-neutral-400">
              <span class="inline-flex items-center"><span class="material-symbols-outlined mi text-primary-400 text-[16px] mr-1">warehouse</span> Global Supplies</span>
              <span class="material-symbols-outlined mi text-primary-400 group-hover:translate-x-1 transition-transform text-[16px]">chevron_right</span>
            </div>
          </div>

          <div class="glass-card rounded-3xl p-8 border border-primary-800 hover:border-primary-400 transition-all duration-300 relative group overflow-hidden bg-gradient-to-b from-neutral-800 to-neutral-900">
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-3">
                <FlagIcon country="ve" />
                <div>
                  <h3 class="text-2xl font-bold text-white">VENEZUELA</h3>
                  <span class="text-white text-sm">NARVI ENTERPRISE CORPORATION C.A</span>
                </div>
              </div>
              <span class="absolute top-0 right-0 mt-3 mr-3 px-3 py-1 rounded-full bg-primary-400 text-slate-950 text-xs font-bold">
                Technical Base
              </span>
            </div>

            <div class="space-y-4">
              <div class="p-4 rounded-2xl bg-neutral-950/80 border border-primary-800">
                <h4 class="text-xs font-bold uppercase text-primary-400 mb-1">Operational Role</h4>
                <p class="text-sm font-semibold text-white">
                  Technical operations and field execution center for well
                  pumping services.
                </p>
              </div>
              <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                Workshop infrastructure, in-house laboratories, and specialized
                fleet deployment for active well operations.
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-primary-800/50 flex items-center justify-between text-xs text-neutral-400">
              <span class="inline-flex items-center"><span class="material-symbols-outlined mi text-primary-400 text-[16px] mr-1">handyman</span> Field Deployment</span>
              <span class="material-symbols-outlined mi text-primary-400 group-hover:translate-x-1 transition-transform text-[16px]">chevron_right</span>
            </div>
          </div>

          <div class="glass-card rounded-3xl p-8 border border-primary-800 hover:border-primary-400 transition-all duration-300 relative group overflow-hidden">
            <div class="flex items-center justify-between mb-6">
              <div class="flex items-center gap-3">
                <FlagIcon country="pa" />
                <div>
                  <h3 class="text-2xl font-bold text-white">PANAMA</h3>
                  <span class="text-white text-sm">NARVI ENTERPRISE CORPORATION S.A</span>
                </div>
              </div>
              <span class="absolute top-0 right-0 mt-3 mr-3 px-3 py-1 rounded-full bg-neutral-900 text-primary-400 text-xs font-bold border border-primary-800">
                Corporate HQ
              </span>
            </div>

            <div class="space-y-4">
              <div class="p-4 rounded-2xl bg-neutral-950/80 border border-primary-800">
                <h4 class="text-xs font-bold uppercase text-primary-400 mb-1">Operational Role</h4>
                <p class="text-sm font-semibold text-white">
                  Strategic banking, corporate, and commercial center.
                </p>
              </div>
              <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                Centralizes international financial administration, large-scale
                contract structuring, and institutional commercial relations.
              </p>
            </div>

            <div class="mt-8 pt-4 border-t border-primary-800/50 flex items-center justify-between text-xs text-neutral-400">
              <span class="inline-flex items-center"><span class="material-symbols-outlined mi text-primary-400 text-[16px] mr-1">work</span> Finance & Partnerships</span>
              <span class="material-symbols-outlined mi text-primary-400 group-hover:translate-x-1 transition-transform text-[16px]">chevron_right</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="evolution" class="py-16 bg-neutral-900/40 relative rounded-xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900 text-primary-400 text-xs font-semibold uppercase mb-3 border border-primary-800">
            <span class="material-symbols-outlined mi text-[16px]">timeline</span>
            Trajectory
          </div>
          <h2 class="text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight">
            Our Evolution
          </h2>
          <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
            A continuous path of innovation, financial strength, and expansion
            into key markets.
          </p>
        </div>

        <div class="relative">
          <div class="hidden lg:block absolute top-1/2 left-0 right-0 h-1 bg-gradient-to-r from-primary-800 via-primary-400 to-primary-800 -translate-y-1/2 z-0"></div>

          <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-5 gap-6 relative z-10">
            <div class="glass-card p-6 rounded-2xl border border-primary-800 hover:border-primary-400 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl font-black text-primary-400">2022</span>
                  <span class="text-xs px-2.5 py-1 rounded-md bg-neutral-950 text-neutral-400 border border-primary-800 font-bold">U.S.</span>
                </div>
                <h3 class="text-sm font-bold text-white mb-2">Foundation and Structure</h3>
                <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                  Establishment of the corporate structure and supply chain
                  center in the U.S.
                </p>
              </div>
              <div class="mt-6 pt-3 border-t border-primary-800/40 text-[11px] text-primary-400 font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined mi text-[16px]">check_circle</span>
                <span>Initial Phase</span>
              </div>
            </div>

            <div class="glass-card p-6 rounded-2xl border border-primary-800 hover:border-primary-400 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl font-black text-primary-400">2023</span>
                  <span class="text-xs px-2.5 py-1 ml-4 rounded-md bg-neutral-950 text-neutral-400 border border-primary-800 font-bold text-center">South America</span>
                </div>
                <h3 class="text-sm font-bold text-white mb-2">Logistics Network and Alliances</h3>
                <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                  Strategic alliances in Mexico, Brazil, Ecuador, and Colombia.
                </p>
              </div>
              <div class="mt-6 pt-3 border-t border-primary-800/40 text-[11px] text-neutral-400 font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined mi text-[16px]">explore</span>
                <span>Outlook</span>
              </div>
            </div>

            <div class="glass-card p-6 rounded-2xl border border-primary-800 hover:border-primary-400 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl font-black text-primary-400">2024</span>
                  <span class="text-xs px-2.5 py-1 rounded-md bg-neutral-950 text-neutral-400 border border-primary-800 font-bold">Global</span>
                </div>
                <h3 class="text-sm font-bold text-white mb-2">Commercial Expansion</h3>
                <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                  Entry into the Middle East and Africa, and reactivation in
                  Venezuela.
                </p>
              </div>
              <div class="mt-6 pt-3 border-t border-primary-800/40 text-[11px] text-primary-400 font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined mi text-[16px]">check_circle</span>
                <span>Internationalization</span>
              </div>
            </div>

            <div class="glass-card p-6 rounded-2xl border border-primary-800 hover:border-primary-400 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl font-black text-white group-hover:text-primary-400 transition-colors">2025</span>
                  <span class="text-xs px-2.5 py-1 rounded-md bg-primary-400 text-slate-950 font-bold">Panama</span>
                </div>
                <h3 class="text-sm font-bold text-white mb-2">Financial Management</h3>
                <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                  Consolidation of Panama as the group's banking, commercial,
                  and legal hub.
                </p>
              </div>
              <div class="mt-6 pt-3 border-t border-primary-800/40 text-[11px] text-primary-400 font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined mi text-[16px]">check_circle</span>
                <span>Consolidation</span>
              </div>
            </div>

            <div class="glass-card p-6 rounded-2xl border border-primary-800 hover:border-primary-400 transition-all duration-300 flex flex-col justify-between group bg-neutral-900/80">
              <div>
                <div class="flex items-center justify-between mb-4">
                  <span class="text-3xl font-black text-primary-400">2026</span>
                  <span class="text-xs px-2.5 py-1 rounded-md bg-neutral-950 text-neutral-400 border border-primary-800 font-bold">Venezuela</span>
                </div>
                <h3 class="text-sm font-bold text-white mb-2">Operational Deployment</h3>
                <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                  Direct field execution with well pumping equipment and QHSE
                  integration.
                </p>
              </div>
              <div class="mt-6 pt-3 border-t border-primary-800/40 text-[11px] text-primary-400 font-semibold flex items-center gap-1">
                <span class="material-symbols-outlined mi text-[16px] animate-spin">sync</span>
                <span>Active Operation</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

