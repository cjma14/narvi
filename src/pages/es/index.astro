---
// Import the necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import HeroSection from "@components/sections/landing/HeroSection.astro";
import SolutionsEcosystemSection from "@components/sections/landing/SolutionsEcosystemSection.astro";
import ClientsSection from "@components/sections/landing/ClientsSection.astro";
import FeaturesGeneral from "@components/sections/features/FeaturesGeneral.astro";
import TestimonialsSection from "@components/sections/testimonials/TestimonialsSection.astro";
import FAQ from "@components/sections/misc/FAQ.astro";
import faqs from "@data/es/faqs.json";
import avatar from "@images/avatar.jpg";
import AboutUsSection from "@/components/sections/AboutUsSection.astro";
import BannerSection from "@/components/sections/BannerSection.astro";
import features from "@data/es/features.json";
import TeleprompterSection from "@/components/sections/landing/TeleprompterSection.astro";
import ProductsSection from "@/components/sections/landing/ProductsSection.astro";
import TechPartnersSection from "@components/sections/landing/TechPartnersSection.astro";
import ProjectConsultationSection from "@components/sections/landing/ProjectConsultationSection.astro";
import productsIcons from "@data/es/products-icons.json";

const avatarSrcs: Array<string> = [avatar.src];

const solutionsSection = {
  sectionLabel: "Ecosistema de Soluciones",
  title: "Soluciones que Impulsan su Operación",
  subTitle: "Cuando su operación no puede detenerse, nosotros respondemos.",
  ctaLabel: "Solicitar Catálogo",
  ctaUrl: "/es/contact",
  solutions: [
    {
      title: "Servicio de Bombeo a Pozos",
      description:
        "",
      bullets: ["Bombeo en caliente, alta y baja presión", "Bombeo en frío, alta y baja presión", "Estimulación a pozos (Orgánicas e inorgánicas)"],
      image: "/img/pozos.avif",
      imageAlt: "Planta de petróleo y gas para operaciones de servicios de pozos",
      iconName: "building",
    },
    {
      title: "Soluciones Químicas",
      description:
        "",
      bullets: ["Laboratorio In-House"],
      image: "/img/laboratorio.avif",
      imageAlt: "Vehículo de transporte industrial para logística petrolera",
      iconName: "truck",
    },
    {
      title: "Gestión de Activos",
      description:
        "",
      bullets: ["Comercialización de equipos", "Mantenimiento de equipos", "Puesta en marcha de equipos"],
      image: "/img/gestion-activos.avif",
      imageAlt: "Trabajo técnico para repuestos y soporte industrial",
      iconName: "sliders",
    }
  ],
};
---

<MainLayout
  lang="es"
  title="NARVI | Equipos y Servicios para Petróleo, Gas e Industria"
  meta="NARVI - Proveedor líder de equipos, repuestos y soluciones para la industria energética e industrial (Oil & Gas). Más de 25 años de experiencia en Norteamérica y Latinoamérica."
>
  <!-- <AnnouncementBanner
    btnId="dismiss-button"
    btnTitle="Explore ScrewFast on GitHub"
    url="https://github.com/mearashadowfax/ScrewFast"
  /> -->

  <HeroSection
    title=`Liderando la <span class='text-primary-400'>nueva era energética</span> de Venezuela`
    subTitle=""
    primaryBtn="Contactar"
    primaryBtnURL="/es/contact"
    secondaryBtn="Ver Soluciones"
    secondaryBtnURL="#solutions"
    withReview={false}
  />

  <SolutionsEcosystemSection
    sectionLabel={solutionsSection.sectionLabel}
    title={solutionsSection.title}
    subTitle={solutionsSection.subTitle}
    ctaLabel={solutionsSection.ctaLabel}
    ctaUrl={solutionsSection.ctaUrl}
    solutions={solutionsSection.solutions}
  />

  <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <ClientsSection
      label="Nuestros clientes"
      title="Algunas de las empresas que confían en nosotros"
      subTitle="Los líderes confían en nuestros productos y servicios"
    />

    <!-- <TestimonialsSection
      label="How we work"
      title="Descubra cómo trabajamos"
      subTitle="¿Quieres saber cómo transformamos tus ideas en realidad? En Narvi creemos en la colaboración, la innovación y la excelencia. ¡Únete a nosotros en este viaje y descubre por qué nuestros clientes nos eligen!"
      videoUrl="https://youtu.be/pEQnZ6nrDlY"
      testimonials={[
        {
          content:
            '"Trabajar con Narvi ha transformado nuestra eficiencia. Su equipo sostiene nuestra logística."',
          author: "Ingeniero Jefe",
          role: "Ingeniero Jefe @Petroalliance",
          avatarSrc: "/img/clients/testimonial-4.jpeg",
        },
      ]}
    /> -->
  </div>

  <AboutUsSection
    label="Sobre nosotros"
    title="Liderando el futuro"
    subTitle="Vasta experiencia internacional, nos especializamos en maximizar la confiabilidad de los equipos y la eficiencia operativa. Desde Norteamérica hasta Latinoamérica, brindamos ingeniería de proyectos de clase mundial y suministro de equipos especializados."
    videoUrl="https://youtu.be/fRZpiqss7Zw"
    btnExists={true}
    btnTitle="Ver nuestras soluciones"
    btnURL="/es/services"
  />

  <!-- <TeleprompterSection
    text="Con más de 25 años de experiencia en el sector del Oil and Gas, manejo y administración de activos, mantenimiento y confiabilidad de equipos, anivel internacional, en países de Norteamérica y Latinoamérica. Nos hemos enfocado en ofrecer servicios profesionales en la ingeniería de proyectos de equipos, su comercialización y suministro. Nuestra prioridad es la eficacia en cada proyecto, acompañamos tus metas de negocio con innovación y sostenibilidad."
    title="Miguel Mogollón"
    subTitle="Director Ejecutivo y Fundador"
  /> -->

  

  <ProjectConsultationSection
    mainTitle="Su Proyecto requiere"
    mainTitleHighlight="Certeza Operativa"
    mainSubtitle="En entornos de alta exigencia energética, el proveedor correcto marca la diferencia. Estamos listos para apoyar su próxima fase de crecimiento."
    benefit1="Respuesta prioritaria en menos de 24 horas."
    benefit2="Disponibilidad y especificaciones técnicas claras."
    benefit3="Tratamiento de confidencialidad absoluto."
    formTitle="Solicite Información Hoy"
    formSubtitle="Cuéntenos qué necesita su proyecto y nuestro equipo industrial le enviará opciones comerciales a la brevedad."
    formLabels={{
      fullName: "Nombre Completo",
      fullNamePlaceholder: "Ej. Carlos Mendoza",
      company: "Empresa",
      companyPlaceholder: "Nombre de su compañía",
      email: "Correo Electrónico",
      emailPlaceholder: "correo@empresa.com",
      phone: "Teléfono",
      phonePlaceholder: "+1 (555) 000-0000",
      serviceRequired: "Equipo o Servicio Requerido",
      serviceRequiredPlaceholder: "Seleccione una opción",
      projectLocation: "Ubicación del Proyecto",
      projectLocationPlaceholder: "País / Región",
      submitButton: "Enviar Solicitud"
    }}
    serviceOptions={[
      { value: "heavy-machinery", label: "Maquinaria Pesada" },
      { value: "industrial-transport", label: "Transporte Industrial" },
      { value: "spare-parts", label: "Repuestos y Soporte" },
      { value: "well-services", label: "Servicios de Pozos" },
      { value: "project-consulting", label: "Consultoría de Proyectos" },
      { value: "other", label: "Otro" }
    ]}
    successMessage={{
      title: "¡Hemos recibido tu solicitud!",
      description: "Gracias por contactarnos. Nos pondremos en contacto con usted en breve."
    }}
  />

  <TechPartnersSection
    title='Miembros <span class="text-primary-400">Aliados</span>'
    title2='Alianza <span class="text-primary-400">Tecnológica</span>'
    partners={[
      { src: "/img/clients/logo de camara petrolera.avif", alt: "Logo de cámara petrolera" },
      { src: "/img/clients/Logo de CONAPRI.avif", alt: "Logo de CONAPRI" },
    ]}
  />
 
</MainLayout>
