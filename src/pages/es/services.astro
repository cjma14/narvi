---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@/components/ui/blocks/MainSection.astro";

import { SITE } from "@data/constants";
import LeftSection from "@/components/ui/blocks/LeftSection.astro";
import RightSection from "@/components/ui/blocks/RightSection.astro";

const pageTitle: string = `Servicios | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://narvi-ec.com/Servicios",
    url: "https://narvi-ec.com/Servicios",
    name: "Servicios | NARVI",
    description:
      "Soluciones innovadoras para el crecimiento empresarial sostenible.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://narvi-ec.com",
      name: "NARVI",
      description:
        "NARVI ofrece servicios de ingeniería y mantenimiento en todo el continente americano, optimizando sus operaciones en el sector energético.",
    },
    inLanguage: "en-US",
  }}
>
  <MainSection
    label="Servicios"
    title="Servicios avanzados de intervención y producción de pozos"
    backgroundImg="/img/productos-servicios2.avif"
  />

  <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <!-- EL COMPROMISO DE NARVI CON LA EFICIENCIA OPERATIVA (HIGHLIGHT CONTAINER FROM SKETCH) -->
    <section
      class="glass-card relative mt-14 overflow-hidden rounded-3xl border border-primary-800/40 p-8 shadow-2xl sm:p-10"
    >
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-primary-400/10 blur-3xl"
      >
      </div>
      <div
        class="to-emerald-600 absolute left-0 top-0 h-full w-2 bg-gradient-to-b from-primary-400"
      >
      </div>

      <div
        class="mb-8 flex flex-col justify-between gap-4 border-b border-neutral-800/80 pb-6 md:flex-row md:items-center"
      >
        <div>
          <span
            class="mb-1 block text-xs font-extrabold uppercase tracking-widest text-primary-400"
            >VALOR AGREGADO</span
          >
          <h2
            class="flex items-center gap-3 text-3xl font-black text-white md:text-4xl md:leading-tight"
          >
            <span class="material-symbols-outlined text-xl text-primary-400"
              >task_alt</span
            >
            El compromiso de NARVI con la eficiencia operativa
          </h2>
        </div>
        <div class="shrink-0">
          <span
            class="rounded-full border border-primary-400/30 bg-neutral-900 px-3.5 py-1.5 text-xs font-bold text-primary-400"
          >
            Estándares Homologados
          </span>
        </div>
      </div>

      <!-- 4 FEATURE CARDS FROM SKETCH -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- FEATURE 1 -->
        <div
          class="group flex flex-col justify-between rounded-2xl border border-neutral-800 bg-neutral-950/90 p-5 transition-all duration-300 hover:border-primary-400/50"
        >
          <div>
            <div class="mb-4 flex items-center gap-3">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-primary-400/30 bg-neutral-900 text-xl text-primary-400 shadow-md transition-all group-hover:bg-primary-400 group-hover:text-white"
              >
                <span class="material-symbols-outlined">local_shipping</span>
              </div>
              <h3
                class="text-base font-bold text-white transition-colors group-hover:text-primary-400 md:text-lg"
              >
                Flota y Equipos Especializados
              </h3>
            </div>
            <p class="text-pearl-100/85 text-sm md:text-base leading-relaxed">
              Bombeo en caliente, en frío y estimulación a pozos con unidades
              operativas de alta capacidad y mantenimiento preventivo continuo.
            </p>
          </div>
          <div
            class="mt-4 flex items-center justify-between border-t border-neutral-800/50 pt-3 text-[10px] font-bold uppercase tracking-wider text-primary-400"
          >
            <span>Operaciones en Campo</span>
            <span class="material-symbols-outlined text-[12px]"
              >chevron_right</span
            >
          </div>
        </div>

        <!-- FEATURE 2 -->
        <div
          class="group flex flex-col justify-between rounded-2xl border border-neutral-800 bg-neutral-950/90 p-5 transition-all duration-300 hover:border-primary-400/50"
        >
          <div>
            <div class="mb-4 flex items-center gap-3">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-primary-400/30 bg-neutral-900 text-xl text-primary-400 shadow-md transition-all group-hover:bg-primary-400 group-hover:text-white"
              >
                <span class="material-symbols-outlined">science</span>
              </div>
              <h3
                class="text-base font-bold text-white transition-colors group-hover:text-primary-400 md:text-lg"
              >
                Laboratorio In-House
              </h3>
            </div>
            <p class="text-pearl-100/85 text-sm md:text-base leading-relaxed">
              Análisis técnico analítico avanzado que garantiza intervenciones
              altamente eficaces y selección exacta de tratamientos químicos.
            </p>
          </div>
          <div
            class="mt-4 flex items-center justify-between border-t border-neutral-800/50 pt-3 text-[10px] font-bold uppercase tracking-wider text-primary-400"
          >
            <span>Analítica de Fluidos</span>
            <span class="material-symbols-outlined text-[12px]"
              >chevron_right</span
            >
          </div>
        </div>

        <!-- FEATURE 3 -->
        <div
          class="group flex flex-col justify-between rounded-2xl border border-neutral-800 bg-neutral-950/90 p-5 transition-all duration-300 hover:border-primary-400/50"
        >
          <div>
            <div class="mb-4 flex items-center gap-3">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-primary-400/30 bg-neutral-900 text-xl text-primary-400 shadow-md transition-all group-hover:bg-primary-400 group-hover:text-white"
              >
                <span class="material-symbols-outlined">memory</span>
              </div>
              <h3
                class="text-base font-bold text-white transition-colors group-hover:text-primary-400 md:text-lg"
              >
                Tecnología e IA
              </h3>
            </div>
            <p class="text-pearl-100/85 text-sm md:text-base leading-relaxed">
              Monitoreo y control en tiempo real para optimizar procesos,
              predecir variaciones de presión y prevenir desviaciones
              operativas.
            </p>
          </div>
          <div
            class="mt-4 flex items-center justify-between border-t border-neutral-800/50 pt-3 text-[10px] font-bold uppercase tracking-wider text-primary-400"
          >
            <span>Telemetría 24/7</span>
            <span class="material-symbols-outlined text-[12px]"
              >chevron_right</span
            >
          </div>
        </div>

        <!-- FEATURE 4 -->
        <div
          class="group flex flex-col justify-between rounded-2xl border border-neutral-800 bg-neutral-950/90 p-5 transition-all duration-300 hover:border-primary-400/50"
        >
          <div>
            <div class="mb-4 flex items-center gap-3">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-primary-400/30 bg-neutral-900 text-xl text-primary-400 shadow-md transition-all group-hover:bg-primary-400 group-hover:text-white"
              >
                <span class="material-symbols-outlined">shield</span>
              </div>
              <h3
                class="text-base font-bold text-white transition-colors group-hover:text-primary-400 md:text-lg"
              >
                Seguridad e Integridad
              </h3>
            </div>
            <p class="text-pearl-100/85 text-sm md:text-base leading-relaxed">
              Gestión integral homologada bajo los más altos estándares
              internacionales de calidad, ambiente y seguridad ISO y API.
            </p>
          </div>
          <div
            class="mt-4 flex items-center justify-between border-t border-neutral-800/50 pt-3 text-[10px] font-bold uppercase tracking-wider text-primary-400"
          >
            <span>Normativa ISO & API</span>
            <span class="material-symbols-outlined text-[12px]"
              >chevron_right</span
            >
          </div>
        </div>
      </div>
    </section>

    <RightSection
      id="bombeo-a-pozos"
      title="Portafolio de servicios petroleros"
      subTitle="Con base operativa en El Tigre, brindamos capacidades técnicas para mantenimiento, intervención y optimización de pozos, con equipos y personal especializado para ejecutar servicios de bombeo en campo de forma segura, eficiente y alineada a las exigencias operacionales de cada cliente."
      single={true}
      imgOne="/img/pozos.avif"
      imgOneAlt="Unidad de bombeo en operación de campo"
      items={[
        "Bombeo en caliente, alta y baja presión.",
        "Bombeo en frío, alta y baja presión.",
        "Estimulación a pozos (Orgánicas e inorgánicas).",
      ]}
      btnExists={true}
      btnTitle="Contactar con ventas"
      btnURL="/contact"
    />

    <LeftSection
      id="laboratorio-in-house"
      title="Laboratorio In-House"
      subTitle="Nuestro laboratorio interno está equipado con tecnología de punta para realizar análisis de fluidos y químicos, garantizando intervenciones altamente eficaces y la selección precisa de tratamientos químicos. Con un enfoque en la calidad y la eficiencia, nuestro laboratorio respalda nuestras operaciones de campo con datos confiables y resultados rápidos."
      img="/img/laboratorio.avif"
      imgAlt="Laboratorio interno de Narvi Enterprise Corporation"
      btnExists={true}
      btnTitle="Contactar con ventas"
      btnURL="/contact"
      items={[
        "Determinación de PH.",
        "Porcentaje de sólidos totales.",
        "Compatibilidad con arcilla.",
        "Medición de % de agua y sedimentos.",
        "Estabilidad de emulsiones.",
        "Viscosidad.",
        "Ensayo de solubilidad.",
        "Análisis de precipitados.",
        "Compatibilidad de químicos-crudos.",
      ]}
    />

    <RightSection
      id="asset-management"
      title="Gestión de activos"
      subTitle="Nuestro enfoque garantiza el máximo rendimiento y el valor maximizado desde la adquisición hasta la disposición. A través de la planificación estratégica, la adquisición precisa, la excelencia operativa y el mantenimiento constante, potenciamos sus activos para que contribuyan a su éxito."
      imgOne="/img/getion-de-activos.avif"
      imgOneAlt="Personal de Narvi realizando un estudio de gestión de activos"
      btnExists={true}
      single={true}
      btnTitle="Ver soluciones"
      btnURL="/es/sales"
      items={[
        "Comercialización de Equipos",
        "Mantenimiento de equipos",
        "Puesta en marcha de equipos",
      ]}
    />
  </div>
</MainLayout>
<style>
  .glass-card {
    background: rgba(29, 37, 35, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
  }
</style>
