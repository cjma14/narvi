---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@/components/ui/blocks/MainSection.astro";

import { SITE } from "@data/constants";
import LeftSection from "@/components/ui/blocks/LeftSection.astro";
import RightSection from "@/components/ui/blocks/RightSection.astro";

const pageTitle: string = `Servicios | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://narvi-ec.com/Servicios",
    url: "https://narvi-ec.com/Servicios",
    name: "Servicios | Narvi EC",
    description:
      "Soluciones innovadoras para el crecimiento empresarial sostenible.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://narvi-ec.com",
      name: "Narvi Enterprise Corporation",
      description:
        "Narvi EC ofrece servicios de ingeniería y mantenimiento en todo el continente americano, optimizando sus operaciones en el sector energético.",
    },
    inLanguage: "en-US",
  }}
>
  <MainSection
    label="Servicios"
    title="Soluciones innovadoras para el crecimiento empresarial sostenible."
    backgroundImg="/img/service15.png"
  />

  <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <!-- EL COMPROMISO DE NARVI CON LA EFICIENCIA OPERATIVA (HIGHLIGHT CONTAINER FROM SKETCH) -->
    <section
      class="glass-card border-primary-800/40 relative mt-14 overflow-hidden rounded-3xl border p-8 shadow-2xl sm:p-10"
    >
      <div
        class="bg-primary-400/10 pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full blur-3xl"
      >
      </div>
      <div
        class="from-primary-400 to-emerald-600 absolute left-0 top-0 h-full w-2 bg-gradient-to-b"
      >
      </div>

      <div
        class="border-neutral-800/80 mb-8 flex flex-col justify-between gap-4 border-b pb-6 md:flex-row md:items-center"
      >
        <div>
          <span
            class="text-primary-400 mb-1 block text-xs font-extrabold uppercase tracking-widest"
            >Valor Añadido Garantizado</span
          >
          <h2
            class="flex items-center gap-3 text-2xl font-black text-white sm:text-3xl"
          >
            <span class="material-symbols-outlined text-primary-400 text-xl">task_alt</span>
            El compromiso de Narvi con la eficiencia operativa
          </h2>
        </div>
        <div class="shrink-0">
          <span
            class="bg-neutral-900 border-primary-400/30 text-primary-400 rounded-full border px-3.5 py-1.5 text-xs font-bold"
          >
            Estándares Homologados
          </span>
        </div>
      </div>

      <!-- 4 FEATURE CARDS FROM SKETCH -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- FEATURE 1 -->
        <div
          class="bg-neutral-950/90 border-neutral-800 hover:border-primary-400/50 group flex flex-col justify-between rounded-2xl border p-5 transition-all duration-300"
        >
          <div>
            <div
              class="bg-neutral-900 border-primary-400/30 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-4 flex h-12 w-12 items-center justify-center rounded-xl border text-xl shadow-md transition-all"
            >
              <span class="material-symbols-outlined">local_shipping</span>
            </div>
            <h3
              class="group-hover:text-primary-400 mb-2 text-sm font-bold text-white transition-colors"
            >
              Flota y Equipos Especializados
            </h3>
            <p class="text-neutral-400 text-xs leading-relaxed">
              Bombeo en caliente, en frío y estimulación a pozos con unidades
              operativas de alta capacidad y mantenimiento preventivo continuo.
            </p>
          </div>
          <div
            class="border-neutral-800/50 text-primary-400 mt-4 flex items-center justify-between border-t pt-3 text-[10px] font-bold uppercase tracking-wider"
          >
            <span>Operaciones en Campo</span>
            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          </div>
        </div>

        <!-- FEATURE 2 -->
        <div
          class="bg-neutral-950/90 border-neutral-800 hover:border-primary-400/50 group flex flex-col justify-between rounded-2xl border p-5 transition-all duration-300"
        >
          <div>
            <div
              class="bg-neutral-900 border-primary-400/30 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-4 flex h-12 w-12 items-center justify-center rounded-xl border text-xl shadow-md transition-all"
            >
              <span class="material-symbols-outlined">science</span>
            </div>
            <h3
              class="group-hover:text-primary-400 mb-2 text-sm font-bold text-white transition-colors"
            >
              Laboratorio In-House
            </h3>
            <p class="text-neutral-400 text-xs leading-relaxed">
              Análisis técnico analítico avanzado que garantiza intervenciones
              altamente eficaces y selección exacta de tratamientos químicos.
            </p>
          </div>
          <div
            class="border-neutral-800/50 text-primary-400 mt-4 flex items-center justify-between border-t pt-3 text-[10px] font-bold uppercase tracking-wider"
          >
            <span>Analítica de Fluidos</span>
            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          </div>
        </div>

        <!-- FEATURE 3 -->
        <div
          class="bg-neutral-950/90 border-neutral-800 hover:border-primary-400/50 group flex flex-col justify-between rounded-2xl border p-5 transition-all duration-300"
        >
          <div>
            <div
              class="bg-neutral-900 border-primary-400/30 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-4 flex h-12 w-12 items-center justify-center rounded-xl border text-xl shadow-md transition-all"
            >
              <span class="material-symbols-outlined">memory</span>
            </div>
            <h3
              class="group-hover:text-primary-400 mb-2 text-sm font-bold text-white transition-colors"
            >
              Tecnología e IA
            </h3>
            <p class="text-neutral-400 text-xs leading-relaxed">
              Monitoreo y control en tiempo real para optimizar procesos,
              predecir variaciones de presión y prevenir desviaciones
              operativas.
            </p>
          </div>
          <div
            class="border-neutral-800/50 text-primary-400 mt-4 flex items-center justify-between border-t pt-3 text-[10px] font-bold uppercase tracking-wider"
          >
            <span>Telemetría 24/7</span>
            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          </div>
        </div>

        <!-- FEATURE 4 -->
        <div
          class="bg-neutral-950/90 border-neutral-800 hover:border-primary-400/50 group flex flex-col justify-between rounded-2xl border p-5 transition-all duration-300"
        >
          <div>
            <div
              class="bg-neutral-900 border-primary-400/30 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-4 flex h-12 w-12 items-center justify-center rounded-xl border text-xl shadow-md transition-all"
            >
              <span class="material-symbols-outlined">shield</span>
            </div>
            <h3
              class="group-hover:text-primary-400 mb-2 text-sm font-bold text-white transition-colors"
            >
              Seguridad e Integridad
            </h3>
            <p class="text-neutral-400 text-xs leading-relaxed">
              Gestión integral homologada bajo los más altos estándares
              internacionales de calidad, ambiente y seguridad ISO y API.
            </p>
          </div>
          <div
            class="border-neutral-800/50 text-primary-400 mt-4 flex items-center justify-between border-t pt-3 text-[10px] font-bold uppercase tracking-wider"
          >
            <span>Normativa ISO & API</span>
            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          </div>
        </div>
      </div>
    </section>

    <RightSection
      id="bombeo-a-pozos"
      title="Servicios de Bombeo a Pozos"
      subTitle="Con base operativa en El Tigre, brindamos capacidades técnicas para mantenimiento, intervención y optimización de pozos, con equipos y personal especializado para ejecutar servicios de bombeo en campo de forma segura, eficiente y alineada a las exigencias operacionales de cada cliente."
      single={true}
      imgOne="/img/pozos.avif"
      imgOneAlt="Unidad de bombeo en operación de campo"
      items={[
        "Servicios de bombeo para pozos de producción activos.",
        "Servicios de bombeo caliente.",
        "Servicios de bombeo frío.",
        "Estimulación y rehabilitación (Acidificación/Acidizing).",
      ]}
      btnExists={true}
      btnTitle="Contactar con ventas"
      btnURL="/contact"
    />


    <LeftSection
      id="asset-management"
      title="Gestión de activos"
      subTitle="En NARVI, redefinimos la gestión de activos mediante la supervisión meticulosa del ciclo de vida de su maquinaria, equipo e infraestructura. Nuestro enfoque garantiza el máximo rendimiento y el valor maximizado desde la adquisición hasta la disposición. A través de la planificación estratégica, la adquisición precisa, la excelencia operativa y el mantenimiento constante, potenciamos sus activos para que contribuyan a su éxito. Confíe en NARVI para mejorar su experiencia en gestión de activos."
      img="/img/getion-de-activos.avif"
      imgAlt="Personal de Narvis realizando un estudio de gestión de activos"
      btnExists={true}
      btnTitle="Contactar con ventas"
      btnURL="/contact"
      items={[
        "Consultoría sobre valor y rendimiento de activo",
        "Adquisición de activos confiable",
        "Garantía y control en la adquisición de sus activos de flota",
        "Asistencia en la administración y gestión de activo",
      ]}
    />

    <RightSection
      id="bussines-analysis"
      title="Laboratorio Quimico In-House (Servicios Petroleros / Oilfield Services)"
      subTitle="Contamos con servicio de analisis y pruebas quimicas en sitio, disenado para realizar evaluaciones en tiempo real, optimizacion de fluidos y control de calidad directamente en el pozo o en la base operativa regional. Al eliminar los retrasos logisticos asociados al envio de muestras a laboratorios externos distantes, este servicio permite tomar decisiones rapidas y respaldadas por datos, minimizando el tiempo no productivo (NPT) y garantizando la maxima eficiencia operativa en el campo."
      single={true}
      imgOne="/img/service30.avif"
      imgOneAlt="Servicio de laboratorio quimico en campo para operaciones petroleras"
      items={[
        "Acondicionamiento de fluidos en tiempo real",
        "Quimica de produccion y aseguramiento de flujo",
        "Integridad de activos y control de corrosion",
        "Caracterizacion del agua de produccion",
        "Eliminacion de tiempos muertos (NPT)",
      ]}
      btnExists={true}
      btnTitle="Contactar con ventas"
      btnURL="/contact"
    />
  </div>
</MainLayout>
<style>
.glass-card {
    background: rgba(29, 37, 35, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
}
</style>
