---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@/components/ui/blocks/MainSection.astro";

import { SITE } from "@data/constants";
import LeftSection from "@/components/ui/blocks/LeftSection.astro";
import RightSection from "@/components/ui/blocks/RightSection.astro";
import productsFeatures from "@data/es/products-features.json";

const pageTitle: string = `Products | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://narvi-ec.com/es/products",
    url: "https://narvi-ec.com/es/products",
    name: "Productos | NARVI",
    description:
      "Soluciones integrales para la industria del petróleo y el gas.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://narvi-ec.com",
      name: "NARVI",
      description:
        "NARVI ofrece servicios de ingeniería y mantenimiento en todo el continente americano, optimizando sus operaciones en el sector energético.",
    },
    inLanguage: "es",
  }}
>
  <MainSection
    label="Sostenibilidad"
    title="Soluciones integrales para la industria"
    backgroundImg="/img/portada de sostenibilidad.avif"
  />
  <!-- 4 PILARES DE SOSTENIBILIDAD (BOCETO EXACTO) -->
  <section
    class="relative border-b border-primary-800/40 bg-neutral-900/30 py-20"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto mb-16 max-w-2xl text-center">
        <span
          class="text-xs font-bold uppercase tracking-widest text-primary-400"
          >Pilares Estratégicos</span
        >
        <h2
          class="mt-2 text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight"
        >
          Ejes Fundamentales de Nuestra Estrategia
        </h2>
        <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
          Cuatro compromisos de acción directa en nuestras operaciones diarias
          en campo e instalaciones corporativas.
        </p>
      </div>

      <!-- GRID OF 4 PILLARS FROM SKETCH -->
      <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
        <!-- PILAR 1: OPERACIONES RESPONSABLES -->
        <div
          class="glass-card group relative flex flex-col justify-between rounded-3xl border border-primary-800 p-8 transition-all duration-300 hover:border-primary-400"
        >
          <div>
            <div class="mb-6 flex items-center justify-between">
              <div
                class="flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-400/40 bg-neutral-900 text-2xl text-primary-400 shadow-md transition-all group-hover:bg-primary-400 group-hover:text-white"
              >
                <span
                  class="material-symbols-outlined text-current transition-colors group-hover:text-white"
                  >eco</span
                >
              </div>
              <span
                class="text-3xl font-black text-primary-800 transition-colors group-hover:text-primary-400/30"
                >01</span
              >
            </div>
            <h3
              class="mb-3 text-xl font-bold text-white transition-colors group-hover:text-primary-400 sm:text-2xl"
            >
              1. OPERACIONES RESPONSABLES
            </h3>
            <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
              Nuestro primer compromiso es desarrollar operaciones seguras,
              eficientes y ambientalmente responsables. Trabajamos bajo un
              Sistema de Gestión Integrado orientado a estándares
              internacionales de calidad, ambiente, seguridad y salud
              ocupacional, incorporando la prevención de riesgos, el
              cumplimiento regulatorio y la mejora continua como elementos
              fundamentales de nuestras operaciones.
            </p>
          </div>

          <!-- COMMITMENT QUOTE BOX FROM SKETCH -->
          <div
            class="rounded-2xl border-y border-l-4 border-r border-primary-400 border-primary-800/60 bg-neutral-950/90 p-4 sm:p-5"
          >
            <span
              class="mb-1 block text-[10px] font-extrabold uppercase tracking-widest text-primary-400"
              >Nuestro Compromiso</span
            >
            <p class="text-xs font-medium italic text-white sm:text-sm">
              "Prevenir incidentes, minimizar impactos ambientales y utilizar
              los recursos de manera cada vez más eficiente"
            </p>
          </div>
        </div>

        <!-- PILAR 2: PERSONAS Y COMUNIDADES -->
        <div
          class="glass-card group relative flex flex-col justify-between rounded-3xl border border-primary-800 p-8 transition-all duration-300 hover:border-primary-400"
        >
          <div>
            <div class="mb-6 flex items-center justify-between">
              <div
                class="flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-400/40 bg-neutral-900 text-2xl text-primary-400 shadow-md transition-all group-hover:bg-primary-400 group-hover:text-white"
              >
                <span
                  class="material-symbols-outlined text-current transition-colors group-hover:text-white"
                  >groups</span
                >
              </div>
              <span
                class="text-3xl font-black text-primary-800 transition-colors group-hover:text-primary-400/30"
                >02</span
              >
            </div>
            <h3
              class="mb-3 text-xl font-bold text-white transition-colors group-hover:text-primary-400 sm:text-2xl"
            >
              2. PERSONAS Y COMUNIDADES
            </h3>
            <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
              Creemos que el desarrollo de la industria debe generar
              oportunidades y capacidades en los territorios donde operamos.
              Promovemos una cultura basada en seguridad, respeto, desarrollo
              profesional, diversidad de capacidades y generación de empleo y
              conocimiento local. En la <strong class="text-white"
                >Faja Petrolífera del Orinoco</strong
              >, nuestra aspiración es crecer conjuntamente con nuestro entorno,
              contribuyendo progresivamente al desarrollo de talento,
              proveedores y capacidades locales.
            </p>
          </div>

          <!-- COMMITMENT QUOTE BOX FROM SKETCH -->
          <div
            class="mt-4 rounded-2xl border-y border-l-4 border-r border-primary-400 border-primary-800/60 bg-neutral-950/90 p-4 sm:p-5"
          >
            <span
              class="mb-1 block text-[10px] font-extrabold uppercase tracking-widest text-primary-400"
              >Nuestro Compromiso</span
            >
            <p class="text-xs font-medium italic text-white sm:text-sm">
              "Proteger a nuestra gente, desarrollar talento local y contribuir
              positivamente a las comunidades donde operamos"
            </p>
          </div>
        </div>

        <!-- PILAR 3: EFICIENCIA E INNOVACIÓN -->
        <div
          class="glass-card group relative flex flex-col justify-between rounded-3xl border border-primary-800 p-8 transition-all duration-300 hover:border-primary-400"
        >
          <div>
            <div class="mb-6 flex items-center justify-between">
              <div
                class="flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-400/40 bg-neutral-900 text-2xl text-primary-400 shadow-md transition-all group-hover:bg-primary-400 group-hover:text-white"
              >
                <span
                  class="material-symbols-outlined text-current transition-colors group-hover:text-white"
                  >memory</span
                >
              </div>
              <span
                class="text-3xl font-black text-primary-800 transition-colors group-hover:text-primary-400/30"
                >03</span
              >
            </div>
            <h3
              class="mb-3 text-xl font-bold text-white transition-colors group-hover:text-primary-400 sm:text-2xl"
            >
              3. EFICIENCIA E INNOVACIÓN
            </h3>
            <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
              Para NARVI, sostenibilidad también significa hacer más eficiente
              cada operación. Aplicamos tecnología, monitoreo en tiempo real,
              análisis de datos e inteligencia artificial para mejorar el
              desempeño de nuestros servicios, anticipar desviaciones, aumentar
              la confiabilidad de los equipos y reducir tiempos no productivos.
            </p>
          </div>

          <!-- COMMITMENT QUOTE BOX FROM SKETCH -->
          <div
            class="mt-4 rounded-2xl border-y border-l-4 border-r border-primary-400 border-primary-800/60 bg-neutral-950/90 p-4 sm:p-5"
          >
            <span
              class="mb-1 block text-[10px] font-extrabold uppercase tracking-widest text-primary-400"
              >Nuestro Compromiso</span
            >
            <p class="text-xs font-medium italic text-white sm:text-sm">
              "Utilizar innovación y tecnología para producir mejores resultados
              utilizando los recursos de manera más inteligente"
            </p>
          </div>
        </div>

        <!-- PILAR 4: INTEGRIDAD Y GOBERNANZA -->
        <div
          class="glass-card group relative flex flex-col justify-between rounded-3xl border border-primary-800 p-8 transition-all duration-300 hover:border-primary-400"
        >
          <div>
            <div class="mb-6 flex items-center justify-between">
              <div
                class="flex h-14 w-14 items-center justify-center rounded-2xl border border-primary-400/40 bg-neutral-900 text-2xl text-primary-400 shadow-md transition-all group-hover:bg-primary-400 group-hover:text-white"
              >
                <span
                  class="material-symbols-outlined text-current transition-colors group-hover:text-white"
                  >balance</span
                >
              </div>
              <span
                class="text-3xl font-black text-primary-800 transition-colors group-hover:text-primary-400/30"
                >04</span
              >
            </div>
            <h3
              class="mb-3 text-xl font-bold text-white transition-colors group-hover:text-primary-400 sm:text-2xl"
            >
              4. INTEGRIDAD Y GOBERNANZA
            </h3>
            <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
              La sostenibilidad comienza con la manera en que hacemos negocios.
              Actuamos bajo principios de ética, transparencia, cumplimiento,
              responsabilidad y respeto por nuestros clientes, trabajadores,
              proveedores y aliados, incorporando estos principios en nuestras
              decisiones y relaciones comerciales.
            </p>
          </div>

          <!-- COMMITMENT QUOTE BOX FROM SKETCH -->
          <div
            class="rounded-2xl border-y border-l-4 border-r border-primary-400 border-primary-800/60 bg-neutral-950/90 p-4 sm:p-5"
          >
            <span
              class="mb-1 block text-[10px] font-extrabold uppercase tracking-widest text-primary-400"
              >Nuestro Compromiso</span
            >
            <p class="text-xs font-medium italic text-white sm:text-sm">
              "Crecer con integridad, transparencia y responsabilidad
              construyendo relaciones de largo plazo basadas en la confianza"
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- EVOLUCIÓN DE LA ESTRATEGIA (BOCETO EXACTO) -->
  <section
    class="relative border-b border-primary-800/50 bg-neutral-900/60 py-20"
  >
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12">
        <div class="space-y-6 lg:col-span-6">
          <div
            class="inline-flex items-center gap-2 rounded-full border border-primary-800 bg-neutral-900 px-3 py-1 text-xs font-semibold uppercase text-primary-400"
          >
            <span class="material-symbols-outlined text-[16px]"
              >trending_up</span
            >
            Hoja de Ruta Metodológica
          </div>
          <h2
            class="mt-2 text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight"
          >
            Evolución de la Estrategia
          </h2>
          <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
            Durante la etapa inicial de operaciones, <strong class="text-white"
              >NARVI desarrollará progresivamente una línea base de desempeño</strong
            > que permita establecer indicadores y metas medibles en áreas clave
            como seguridad, desempeño ambiental, eficiencia operativa, desarrollo
            de talento, creación de valor local y cumplimiento.
          </p>

          <!-- HIGHLIGHT BOX FOR CREACIÓN DE VALOR LOCAL -->
          <div
            class="group relative overflow-hidden rounded-2xl border border-primary-400/30 bg-neutral-800/90 p-6"
          >
            <div
              class="absolute -bottom-8 -right-8 h-32 w-32 rounded-full bg-primary-400/10 blur-xl transition-all group-hover:bg-primary-400/20"
            >
            </div>
            <div class="flex items-start gap-4">
              <div
                class="mt-1 flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary-400 text-lg font-bold text-white"
              >
                <span class="material-symbols-outlined text-[20px]"
                  >handshake</span
                >
              </div>
              <div>
                <h3 class="mb-1 text-base font-bold text-white">
                  Creación de Valor Local (Concepto Transversal)
                </h3>
                <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
                  Será un concepto transversal de la estrategia, promoviendo
                  progresivamente el <strong class="text-primary-400"
                    >empleo local, formación técnica, participación de
                    proveedores nacionales y transferencia de conocimiento</strong
                  > en cada proyecto.
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- INTERACTIVE INDICATORS CARD -->
        <div class="lg:col-span-6">
          <div
            class="glass-card space-y-4 rounded-3xl border border-primary-800 p-8"
          >
            <h3 class="flex items-center gap-2 text-lg font-bold text-white">
              <span
                class="material-symbols-outlined text-[18px] text-primary-400"
                >tune</span
              >
              Indicadores y Metas Medibles
            </h3>
            <p class="text-sm text-pearl-100/85 md:text-base">
              Monitoreo continuo en nuestra matriz de desempeño de
              sostenibilidad:
            </p>

            <div class="space-y-3 pt-2">
              <div
                class="flex items-center justify-between rounded-xl border border-primary-800 bg-neutral-950 p-3.5"
              >
                <div
                  class="flex items-center gap-3 text-xs font-semibold text-white"
                >
                  <span
                    class="material-symbols-outlined text-[18px] text-primary-400"
                    >shield</span
                  >
                  <span class="text-sm">Seguridad y Salud Ocupacional</span>
                </div>
                <span
                  class="rounded bg-primary-400/20 px-2 py-0.5 text-[11px] font-bold text-primary-400"
                  >Cero Incidentes</span
                >
              </div>

              <div
                class="flex items-center justify-between rounded-xl border border-primary-800 bg-neutral-950 p-3.5"
              >
                <div
                  class="flex items-center gap-3 text-xs font-semibold text-white"
                >
                  <span
                    class="material-symbols-outlined text-[18px] text-primary-400"
                    >forest</span
                  >
                  <span class="text-sm">Desempeño Ambiental y Huella</span>
                </div>
                <span
                  class="rounded bg-primary-400/20 px-2 py-0.5 text-[11px] font-bold text-primary-400"
                  >Línea Base 2026</span
                >
              </div>

              <div
                class="flex items-center justify-between rounded-xl border border-primary-800 bg-neutral-950 p-3.5"
              >
                <div
                  class="flex items-center gap-3 text-xs font-semibold text-white"
                >
                  <span
                    class="material-symbols-outlined text-[18px] text-primary-400"
                    >speed</span
                  >
                  <span class="text-sm">Eficiencia Operativa e IA</span>
                </div>
                <span
                  class="rounded bg-primary-400/20 px-2 py-0.5 text-[11px] font-bold text-primary-400"
                  >Optimización NPT</span
                >
              </div>

              <div
                class="flex items-center justify-between rounded-xl border border-primary-800 bg-neutral-950 p-3.5"
              >
                <div
                  class="flex items-center gap-3 text-xs font-semibold text-white"
                >
                  <span
                    class="material-symbols-outlined text-[18px] text-primary-400"
                    >school</span
                  >
                  <span class="text-sm">Desarrollo de Talento Local</span>
                </div>
                <span
                  class="rounded bg-primary-400/20 px-2 py-0.5 text-[11px] font-bold text-primary-400"
                  >Capacitación Técnica</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- NUESTRO PROPÓSITO & ESTÁNDARES INTERNACIONALES (BOCETO EXACTO) -->
  <section class="relative overflow-hidden py-20">
    <div class="mx-auto max-w-7xl space-y-16 px-4 sm:px-6 lg:px-8">
      <!-- PURPOSE BOX FROM SKETCH -->
      <div
        class="glass-card relative overflow-hidden rounded-3xl border border-primary-400/40 bg-gradient-to-r from-neutral-800 via-neutral-900 to-neutral-800 p-8 text-center shadow-2xl sm:p-12"
      >
        <div
          class="pointer-events-none absolute right-0 top-0 h-64 w-64 rounded-full bg-primary-400/10 blur-3xl"
        >
        </div>

        <span
          class="mb-2 block text-xs font-black uppercase tracking-widest text-primary-400"
        >
          NUESTRO PROPÓSITO
        </span>
        <h2
          class="mx-auto mt-2 max-w-4xl text-balance text-3xl font-bold text-pearl-100 md:text-4xl md:leading-tight"
        >
          "Contribuir a una industria energética más segura, eficiente,
          responsable y tecnológicamente avanzada, generando valor sostenible
          para Venezuela."
        </h2>
      </div>

      <!-- STANDARDS & CERTIFICATIONS FROM SKETCH -->
      <div>
        <div class="mx-auto mb-10 max-w-2xl text-center">
          <span
            class="text-xs font-bold uppercase tracking-widest text-primary-400"
            >Gobernanza y Calidad</span
          >
          <h3
            class="mx-auto mt-1 max-w-4xl text-balance text-3xl font-bold text-pearl-100 md:text-4xl md:leading-tight"
          >
            Regidos por Estándares Nacionales e Internacionales
          </h3>
        </div>

        <div class="grid grid-cols-2 gap-6 sm:grid-cols-3">
          <!-- ISO 9001 -->
          <div
            class="glass-card group rounded-2xl border border-primary-800 p-6 text-center transition-all duration-300 hover:border-primary-400"
          >
            <div
              class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full border border-primary-400/50 bg-neutral-900 text-2xl text-primary-400 shadow-lg transition-transform group-hover:scale-110"
            >
              <span class="material-symbols-outlined text-[24px]"
                >workspace_premium</span
              >
            </div>
            <h4 class="text-base font-extrabold text-white">ISO 9001:2015</h4>
            <p
              class="mt-1 text-[11px] font-semibold uppercase text-neutral-400"
            >
              Gestión de la Calidad
            </p>
          </div>

          <!-- ISO 14001 -->
          <div
            class="glass-card group rounded-2xl border border-primary-800 p-6 text-center transition-all duration-300 hover:border-primary-400"
          >
            <div
              class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full border border-primary-400/50 bg-neutral-900 text-2xl text-primary-400 shadow-lg transition-transform group-hover:scale-110"
            >
              <span class="material-symbols-outlined text-[24px]">eco</span>
            </div>
            <h4 class="text-base font-extrabold text-white">ISO 14001:2015</h4>
            <p
              class="mt-1 text-[11px] font-semibold uppercase text-neutral-400"
            >
              Gestión Ambiental
            </p>
          </div>

          <!-- ISO 45001 -->
          <div
            class="glass-card group rounded-2xl border border-primary-800 p-6 text-center transition-all duration-300 hover:border-primary-400"
          >
            <div
              class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full border border-primary-400/50 bg-neutral-900 text-2xl text-primary-400 shadow-lg transition-transform group-hover:scale-110"
            >
              <span class="material-symbols-outlined text-[24px]"
                >shield_person</span
              >
            </div>
            <h4 class="text-base font-extrabold text-white">ISO 45001:2018</h4>
            <p
              class="mt-1 text-[11px] font-semibold uppercase text-neutral-400"
            >
              Seguridad y Salud
            </p>
          </div>

          <!-- API -->
          <div
            class="glass-card group rounded-2xl border border-primary-800 p-6 text-center transition-all duration-300 hover:border-primary-400 lg:col-span-3"
          >
            <div
              class="mx-auto mb-4 flex md:h-24 md:w-96 items-center justify-center rounded-full border border-primary-400/50 bg-neutral-900 text-2xl text-primary-400 shadow-lg transition-transform group-hover:scale-110"
            >
              <img
                src="/img/AMERICAN PETROLEUM.avif"
                alt="Logo American Petroleum Institute"
                class="h-full w-full object-contain"
              />
            </div>
            <h4 class="text-base font-extrabold text-white">API</h4>
            <p
              class="mt-1 text-[11px] font-semibold uppercase text-neutral-400"
            >
              American Petroleum Institute
            </p>
          </div>
        </div>
      </div>

      <div class="glass-card rounded-3xl p-8">
        <div class="mb-8 text-center">
          <h3 class="text-4xl font-bold text-pearl-100 md:text-5xl">
             Nuestras Políticas
          </h3>
          <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg mx-auto max-w-2xl">
            Nuestras políticas de calidad, seguridad, salud ocupacional y
            medio ambiente reflejan nuestro compromiso con la excelencia.
          </p>
        </div>

        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
          <div
            class="group rounded-xl border border-primary-800 bg-neutral-950 p-4 text-center transition-all hover:border-primary-400"
          >
            <span
              class="material-symbols-outlined mi mb-2 inline-block text-[20px] text-primary-400 transition-transform group-hover:scale-110"
              >health_and_safety</span
            >
            <h4 class="text-sm font-bold text-white">Política de QHSE</h4>
          </div>

          <div
            class="group rounded-xl border border-primary-800 bg-neutral-950 p-4 text-center transition-all hover:border-primary-400"
          >
            <span
              class="material-symbols-outlined mi mb-2 inline-block text-[20px] text-primary-400 transition-transform group-hover:scale-110"
              >warning</span
            >
            <h4 class="text-sm font-bold text-white">Política de Alcohol y Drogas</h4>
          </div>

          <div
            class="group rounded-xl border border-primary-800 bg-neutral-950 p-4 text-center transition-all hover:border-primary-400"
          >
            <span
              class="material-symbols-outlined mi mb-2 inline-block text-[20px] text-primary-400 transition-transform group-hover:scale-110"
              >directions_car</span
            >
            <h4 class="text-sm font-bold text-white">Política de Conducción</h4>
          </div>

          <div
            class="group rounded-xl border border-primary-800 bg-neutral-950 p-4 text-center transition-all hover:border-primary-400"
          >
            <span
              class="material-symbols-outlined mi mb-2 inline-block text-[20px] text-primary-400 transition-transform group-hover:scale-110"
              >computer</span
            >
            <h4 class="text-sm font-bold text-white">Política de Informática y Tecnología</h4>
          </div>

          <div
            class="group col-span-2 rounded-xl border border-primary-800 bg-neutral-950 p-4 text-center transition-all hover:border-primary-400 sm:col-span-1"
          >
            <span
              class="material-symbols-outlined mi mb-2 inline-block text-[20px] text-primary-400 transition-transform group-hover:scale-110"
              >gavel</span
            >
            <h4 class="text-sm font-bold text-white">Código de Ética y Política Anticorrupción</h4>
          </div>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
