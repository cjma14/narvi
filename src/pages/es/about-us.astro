---
// Import necessary components
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/ui/blocks/MainSection.astro";
import LeftSection from "@components/ui/blocks/LeftSection.astro";
import RightSection from "@components/ui/blocks/RightSection.astro";
import FeaturesStats from "@components/sections/features/FeaturesStats.astro";
import FlagIcon from "@components/ui/FlagIcon.astro";

// Import necessary images
import { SITE } from "@data/constants";

interface aboutItem {
  id?: string;
  isRightSection: boolean;
  title: string;
  subTitle: string;
  btnExists?: boolean;
  btnTitle?: string;
  btnURL?: string;
  single?: boolean;
  img?: any;
  imgAlt?: string;
  imgOne?: any;
  imgOneAlt?: string;
  imgTwo?: any;
  imgTwoAlt?: string;
  items?: string[];
}

const aboutItems: aboutItem[] = [
  {
    id: "mision",
    isRightSection: false,
    title: "Misión",
    subTitle:
      "Brindar un excelente servicio a todos nuestros clientes, garantizando que sus expectativas se cumplan y superen.",
    img: "/img/mission.jpg",
    imgAlt: "Narvi staff offering advice",
    btnExists: false,
  },
  {
    id: "vision",
    isRightSection: false,
    title: "Visión",
    subTitle:
      "Ser una empresa reconocida a nivel nacional e internacional por la excelente gestión de los servicios y productos que brindamos a nuestros clientes, con responsabilidad y eficiencia en cada proyecto.",
    img: "/img/vision.jpg",
    imgAlt: "Cargamento de equipo para venta en Narvi llegando al puerto",
    btnExists: false,
  },
  {
    isRightSection: true,
    title: "Valores",
    subTitle:
      "Nuestro equipo está conformado por profesionales altamente capacitados que comparten nuestra pasión por su trabajo. Trabajamos juntos para lograr la excelencia en todo lo que hacemos, de la mano de los siguientes valores:",
    single: false,
    imgOne: "/img/values1.jpg",
    imgOneAlt: "Ingeniero Narvi haciendo su trabajo",
    imgTwo: "/img/values2.jpg",
    imgTwoAlt: "Ingeniero de Narvi supervisando una operación",
    items: [
      "Compromiso",
      "Responsabilidad",
      "Eficiencia",
      "Profesionalismo",
      "Integridad",
    ],
  },
];

const pageTitle: string = `Sobre nosotros | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://narvi-ec.com/es/about-us",
    url: "https://narvi-ec.com/es/about-us",
    name: "Sobre nosotros | NARVI",
    description: "",
    isPartOf: {
      "@type": "WebSite",
      url: "https://narvi-ec.com",
      name: "NARVI",
      description:
        "NARVI ofrece servicios de ingeniería y mantenimiento en todo el continente americano, optimizando sus operaciones en el sector energético.",
    },
    inLanguage: "en-US",
  }}
>

  <!--MainSection is the introductory section of the page, it also contains a CTA button-->
  <MainSection
    label="Sobre nosotros"
    title="Un aliado confiable en la industria de petróleo y gas"
    backgroundImg="/img/backgorund3.jpg"
  />

  <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <section
      class="relative py-16"
    >
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mx-auto mb-10 text-center">
          <span
            class="text-primary-400 text-sm font-bold uppercase tracking-widest md:text-base"
            >Capacidades Clave</span
          >
          <h2 class="mt-1 text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight">
            Pilares de Excelencia Operativa
          </h2>
          <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">Detrás de cada operación en campo combinamos más de 30 años de
            trayectoria técnica con tecnología de vanguardia para impulsar la
            productividad del sector de petróleo y gas con máxima precisión y seguridad.
            En Narvi Enterprise Corporation integramos excelencia operativa y respaldo
            tecnológico en cada proyecto.</p>
        </div>

        <!-- 4 PILLARS GRID FROM SKETCH -->
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <!-- Pillar 1 -->
          <div
            class="glass-card border-primary-800 hover:border-primary-400 group rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="bg-neutral-900 border-primary-800 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-5 flex h-12 w-12 items-center justify-center rounded-xl border transition-all"
            >
              <span class="material-symbols-outlined mi text-current text-[20px] transition-colors group-hover:text-white">construction</span>
            </div>
            <h3
              class="group-hover:text-primary-400 mb-2 text-base font-bold uppercase tracking-wider text-white transition-colors md:text-lg"
            >
              Servicios Avanzados
            </h3>
            <p class="text-neutral-400 text-sm leading-relaxed md:text-base">
              Intervención y producción especializada de pozos petroleros con
              tecnología de punta.
            </p>
          </div>

          <!-- Pillar 2 -->
          <div
            class="glass-card border-primary-800 hover:border-primary-400 group rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="bg-neutral-900 border-primary-800 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-5 flex h-12 w-12 items-center justify-center rounded-xl border transition-all"
            >
              <span class="material-symbols-outlined mi text-current text-[20px] transition-colors group-hover:text-white">emoji_events</span>
            </div>
            <h3 class="group-hover:text-primary-400 mb-2 text-base font-bold uppercase tracking-wider text-white transition-colors md:text-lg" >Trayectoria Técnica</h3>
            <p
              class="mb-2 text-base font-semibold uppercase tracking-wider text-white md:text-lg"
            >
            </p>
            <p class="text-neutral-400 text-sm leading-relaxed md:text-base">
              30 años de experiencia acumulada en operaciones internacionales de alta
              complejidad.
            </p>
          </div>

          <!-- Pillar 3 -->
          <div
            class="glass-card border-primary-800 hover:border-primary-400 group rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="bg-neutral-900 border-primary-800 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-5 flex h-12 w-12 items-center justify-center rounded-xl border transition-all"
            >
              <span class="material-symbols-outlined mi text-current text-[20px] transition-colors group-hover:text-white">verified_user</span>
            </div>
            <h3
              class="group-hover:text-primary-400 mb-2 text-base font-bold uppercase tracking-wider text-white transition-colors md:text-lg"
            >
              Gestión QHSE Integral
            </h3>
            <p class="text-neutral-400 text-sm leading-relaxed md:text-base">
              Estándares internacionales rigurosos en Calidad, Salud, Seguridad
              y Medio Ambiente.
            </p>
          </div>

          <!-- Pillar 4 -->
          <div
            class="glass-card border-primary-800 hover:border-primary-400 group relative overflow-hidden rounded-2xl border p-6 transition-all duration-300 hover:-translate-y-1"
          >
            <div
              class="bg-primary-400/20 text-primary-400 absolute right-2 top-2 rounded px-2 py-0.5 text-[10px] font-bold"
            >
              TECH
            </div>
            <div
              class="bg-neutral-900 border-primary-800 text-primary-400 group-hover:bg-primary-400 group-hover:text-white mb-5 flex h-12 w-12 items-center justify-center rounded-xl border transition-all"
            >
              <span class="material-symbols-outlined mi text-current text-[20px] transition-colors group-hover:text-white">settings</span>
            </div>
            <h3
              class="group-hover:text-primary-400 mb-2 text-base font-bold uppercase tracking-wider text-white transition-colors md:text-lg"
            >
              IA + GPS Monitoreo
            </h3>
            <p class="text-neutral-400 text-sm leading-relaxed md:text-base">
              Control en tiempo real y telemetría inteligente para activos y
              operaciones críticas.
            </p>
          </div>
        </div>
      </div>
    </section>

     <!-- MISSION, VISION, VALUES SECTION -->
    <section class="py-20 relative rounded-xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <h2 class="text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight">
                    Fundamentos Estratégicos
                </h2>
                <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
                    El motor corporativo que guía nuestras decisiones y relaciones comerciales a nivel global.
                </p>
            </div>

            <!-- CARDS GRID -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
                <!-- MISIÓN -->
                <div class="glass-card p-8 rounded-3xl relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-primary-400/5 rounded-full blur-2xl group-hover:bg-primary-400/15 transition-all"></div>
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-12 rounded-2xl bg-primary-400 text-slate-950 flex items-center justify-center text-2xl font-bold shadow-lg">
                            <span class="material-symbols-outlined mi text-[22px]">track_changes</span>
                        </div>
                        <div>
                            <span class="text-xs font-bold text-primary-400 uppercase tracking-widest">Propósito</span>
                            <h3 class="text-2xl font-bold text-white">Misión</h3>
                        </div>
                    </div>
                    <p class="text-pearl-100 text-base leading-relaxed">
                        Ser aliados estratégicos en el desarrollo de proyectos y crecimiento sostenible, ofreciendo soluciones integrales para el éxito empresarial de nuestros clientes.
                    </p>
                </div>

                <!-- VISIÓN -->
                <div class="glass-card p-8 rounded-3xl relative overflow-hidden group">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-primary-400/5 rounded-full blur-2xl group-hover:bg-primary-400/15 transition-all"></div>
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-12 rounded-2xl bg-primary-400 text-slate-950 flex items-center justify-center text-2xl font-bold shadow-lg">
                            <span class="material-symbols-outlined mi text-[22px]">visibility</span>
                        </div>
                        <div>
                            <span class="text-xs font-bold text-primary-400 uppercase tracking-widest">Futuro</span>
                            <h3 class="text-2xl font-bold text-white">Visión</h3>
                        </div>
                    </div>
                    <p class="text-pearl-100 text-base leading-relaxed">
                        Ser el referente regional en la transición hacia una industria energética más eficiente, sustentable y tecnológicamente avanzada.
                    </p>
                </div>
            </div>

            <!-- VALORES -->
            <div class="glass-card p-8 rounded-3xl">
                <div class="mx-auto mb-10 max-w-4xl text-center">
                    <h3 class="text-3xl font-bold text-pearl-100">Nuestros Valores Corporativos</h3>
                    <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
                        Creemos en nuestra gente. Creemos en la innovación y en nuestra capacidad para transformar desafíos en oportunidades. Creemos que una nueva era energética es posible y queremos ser parte de quienes la construyen.
                    </p>
                    <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
                        En NARVI, nuestros valores orientan cada decisión y definen la manera en que trabajamos con nuestros clientes, nuestra gente, nuestros aliados y las comunidades donde operamos.
                    </p>
                </div>

                <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                    <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-5 rounded-xl transition-all group">
                        <span class="material-symbols-outlined mi text-primary-400 text-[22px] mb-3 group-hover:scale-110 transition-transform inline-block">verified</span>
                        <h4 class="text-lg font-bold uppercase tracking-wide text-white">CONFIABILIDAD</h4>
                        <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-primary-400">Cumplimos lo que prometemos.</p>
                        <p class="mt-3 text-sm leading-relaxed text-pearl-100/80">
                            Operamos con disciplina, calidad y consistencia. Nuestros clientes pueden confiar en nuestra gente, nuestros equipos y nuestra capacidad para entregar resultados de manera segura y eficiente.
                        </p>
                    </div>

                    <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-5 rounded-xl transition-all group">
                        <span class="material-symbols-outlined mi text-primary-400 text-[22px] mb-3 group-hover:scale-110 transition-transform inline-block">lightbulb</span>
                        <h4 class="text-lg font-bold uppercase tracking-wide text-white">INNOVACIÓN</h4>
                        <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-primary-400">Transformamos ideas en mejores operaciones.</p>
                        <p class="mt-3 text-sm leading-relaxed text-pearl-100/80">
                            Incorporamos tecnología, conocimiento y nuevas formas de trabajar para resolver desafíos, aumentar la eficiencia y construir una operación cada vez más inteligente.
                        </p>
                    </div>

                    <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-5 rounded-xl transition-all group">
                        <span class="material-symbols-outlined mi text-primary-400 text-[22px] mb-3 group-hover:scale-110 transition-transform inline-block">groups</span>
                        <h4 class="text-lg font-bold uppercase tracking-wide text-white">COMPROMISO</h4>
                        <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-primary-400">Hacemos nuestros los desafíos de nuestros clientes.</p>
                        <p class="mt-3 text-sm leading-relaxed text-pearl-100/80">
                            Nos involucramos, asumimos los retos como propios y trabajamos con pasión, sentido de urgencia y determinación para alcanzar resultados que generen valor para nuestros clientes, nuestra gente y Venezuela.
                        </p>
                    </div>

                    <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-5 rounded-xl transition-all group">
                        <span class="material-symbols-outlined mi text-primary-400 text-[22px] mb-3 group-hover:scale-110 transition-transform inline-block">gavel</span>
                        <h4 class="text-lg font-bold uppercase tracking-wide text-white">INTEGRIDAD</h4>
                        <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-primary-400">Hacemos lo correcto y asumimos nuestros resultados.</p>
                        <p class="mt-3 text-sm leading-relaxed text-pearl-100/80">
                            Actuamos con ética, transparencia y responsabilidad. Priorizamos la seguridad de las personas y las operaciones, cumplimos nuestros compromisos y respondemos por nuestras decisiones y resultados.
                        </p>
                    </div>

                    <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-5 rounded-xl transition-all group">
                        <span class="material-symbols-outlined mi text-primary-400 text-[22px] mb-3 group-hover:scale-110 transition-transform inline-block">eco</span>
                        <h4 class="text-lg font-bold uppercase tracking-wide text-white">SOSTENIBILIDAD</h4>
                        <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-primary-400">Generamos valor hoy pensando en el mañana.</p>
                        <p class="mt-3 text-sm leading-relaxed text-pearl-100/80">
                            Integramos eficiencia, responsabilidad ambiental, desarrollo de nuestra gente y creación de valor local para contribuir a una industria energética más responsable y sostenible.
                        </p>
                    </div>

                    <div class="bg-neutral-950 border border-primary-800 hover:border-primary-400 p-5 rounded-xl transition-all group">
                        <span class="material-symbols-outlined mi text-primary-400 text-[22px] mb-3 group-hover:scale-110 transition-transform inline-block">shield</span>
                        <h4 class="text-lg font-bold uppercase tracking-wide text-white">SEGURIDAD</h4>
                        <p class="mt-2 text-sm font-semibold uppercase tracking-wide text-primary-400">La seguridad es innegociable.</p>
                        <p class="mt-3 text-sm leading-relaxed text-pearl-100/80">
                            No es solamente una prioridad: es una condición fundamental de nuestra manera de operar.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ECOSISTEMA NARVI SECTION -->
    <section id="ecosistema" class="pt-5 pb-20 relative overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900 text-primary-400 text-xs font-semibold uppercase mb-3 border border-primary-800">
                        <span class="material-symbols-outlined mi text-[16px]">public</span>
                        Presencia Estratégica
                    </div>
                    <h2 class="text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight">
                        Ecosistema Narvi
                    </h2>
                </div>
                <p class="text-pretty text-pearl-100/85 md:text-lg max-w-md mt-4 md:mt-0">
                    Infraestructura conectada internacionalmente para garantizar respuesta rápida y soporte logístico sin interrupciones.
                </p>
            </div>

            <!-- MAP / HUBS DISPLAY -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- USA HUB -->
                <div class="glass-card rounded-3xl p-8 border border-primary-800 hover:border-primary-400 transition-all duration-300 relative group overflow-hidden">
                    <div class="flex items-center justify-between mb-6 mt-4">
                        <div class="flex items-center gap-3">
                            <FlagIcon country="us" />
                            <div>
                                <h3 class="text-2xl font-bold text-white">USA</h3>
                                <span class="text-white text-sm">NARVI ENTERPRISE CORPORATION LLC</span>
                            </div>
                        </div>
                        <span class="absolute right-3 top-3 px-3.5 py-1.5 rounded-full bg-neutral-900 text-primary-400 text-xs font-bold border border-primary-800 leading-none">
                            Hub Logístico
                        </span>
                    </div>

                    <div class="space-y-4">
                        <div class="p-4 rounded-2xl bg-neutral-950/80 border border-primary-800">
                            <h4 class="text-xs font-bold uppercase text-primary-400 mb-1">Rol Operativo</h4>
                            <p class="text-sm font-semibold text-white">
                                Centro principal de gestión de la cadena de suministro (Supply Chain Management).
                            </p>
                        </div>
                        <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                            Asegura la adquisición, control de calidad e importación de equipos técnicos pesados de alta especificación para todas las subsidiarias.
                        </p>
                    </div>

                    <div class="mt-8 pt-4 border-t border-primary-800/50 flex items-center justify-between text-xs text-neutral-400">
                        <span class="inline-flex items-center"><span class="material-symbols-outlined mi text-primary-400 text-[16px] mr-1">warehouse</span> Suministros Globales</span>
                        <span class="material-symbols-outlined mi text-primary-400 group-hover:translate-x-1 transition-transform text-[16px]">chevron_right</span>
                    </div>
                </div>

                <!-- VENEZUELA HUB -->
                <div class="glass-card rounded-3xl p-8 border border-primary-800 hover:border-primary-400 transition-all duration-300 relative group overflow-hidden bg-gradient-to-b from-neutral-800 to-neutral-900">
                    <div class="flex items-center justify-between mb-6 mt-4">
                        <div class="flex items-center gap-3">
                            <FlagIcon country="ve" />
                            <div>
                                <h3 class="text-2xl font-bold text-white">VENEZUELA</h3>
                                <span class="text-white text-sm">NARVI ENTERPRISE CORPORATION C.A</span>
                            </div>
                        </div>
                        <span class="absolute right-3 top-3 px-3.5 py-1.5 rounded-full bg-primary-400 text-slate-950 text-xs font-bold leading-none">
                            Base Técnica y Operativa
                        </span>
                    </div>

                    <div class="space-y-4">
                        <div class="p-4 rounded-2xl bg-neutral-950/80 border border-primary-800">
                            <h4 class="text-xs font-bold uppercase text-primary-400 mb-1">Rol Operativo</h4>
                            <p class="text-sm font-semibold text-white">
                                Centro operativo y de ejecución técnica para los servicios de bombeo a pozos.
                            </p>
                        </div>
                        <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                            Infraestructura de talleres, laboratorios in-house y despliegue de flotas especializadas para operaciones en pozos activos.
                        </p>
                    </div>

                    <div class="mt-8 pt-4 border-t border-primary-800/50 flex items-center justify-between text-xs text-neutral-400">
                        <span class="inline-flex items-center"><span class="material-symbols-outlined mi text-primary-400 text-[16px] mr-1">handyman</span> Despliegue en Campo</span>
                        <span class="material-symbols-outlined mi text-primary-400 group-hover:translate-x-1 transition-transform text-[16px]">chevron_right</span>
                    </div>
                </div>

                <!-- PANAMA HUB -->
                <div class="glass-card rounded-3xl p-8 border border-primary-800 hover:border-primary-400 transition-all duration-300 relative group overflow-hidden">
                    <div class="flex items-center justify-between mb-6 mt-4">
                        <div class="flex items-center gap-3">
                            <FlagIcon country="pa" />
                            <div>
                                <h3 class="text-2xl font-bold text-white">PANAMÁ</h3>
                                <span class="text-white text-sm">NARVI ENTERPRISE CORPORATION S.A</span>
                            </div>
                        </div>
                        <span class="absolute right-3 top-3 px-3.5 py-1.5 rounded-full bg-neutral-900 text-primary-400 text-xs font-bold border border-primary-800 leading-none">
                            Sede Financiera
                        </span>
                    </div>

                    <div class="space-y-4">
                        <div class="p-4 rounded-2xl bg-neutral-950/80 border border-primary-800">
                            <h4 class="text-xs font-bold uppercase text-primary-400 mb-1">Rol Operativo</h4>
                            <p class="text-sm font-semibold text-white">
                                Punto estratégico bancario, corporativo y comercial.
                            </p>
                        </div>
                        <p class="text-sm text-pearl-100/85 md:text-base leading-relaxed">
                            Centraliza la administración financiera internacional, estructuración de contratos de gran escala y relaciones comerciales institucionales.
                        </p>
                    </div>

                    <div class="mt-8 pt-4 border-t border-primary-800/50 flex items-center justify-between text-xs text-neutral-400">
                        <span class="inline-flex items-center"><span class="material-symbols-outlined mi text-primary-400 text-[16px] mr-1">work</span> Finanzas & Alianzas</span>
                        <span class="material-symbols-outlined mi text-primary-400 group-hover:translate-x-1 transition-transform text-[16px]">chevron_right</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- NUESTRA EVOLUCIÓN SECTION (TIMELINE) -->
    <section id="evolucion" class="py-16 bg-neutral-900/40 relative rounded-xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-3xl mx-auto mb-16">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900 text-primary-400 text-xs font-semibold uppercase mb-3 border border-primary-800">
                    <span class="material-symbols-outlined mi text-[16px]">timeline</span>
                    Trayectoria
                </div>
                <h2 class="text-balance text-3xl font-bold text-pearl-100 md:text-5xl md:leading-tight">
                    Nuestra Evolución
                </h2>
                <p class="mt-4 text-pretty text-pearl-100/85 md:text-lg">
                    Un camino continuo de innovación, solidez financiera y expansión hacia mercados clave.
                </p>
            </div>

            <!-- HORIZONTAL TIMELINE FOR DESKTOP / VERTICAL FOR MOBILE -->
            <div class="relative">
                <!-- Connecting Line Desktop -->
