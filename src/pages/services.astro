---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@/components/ui/blocks/MainSection.astro";

import { SITE } from "@data/constants";
import LeftSection from "@/components/ui/blocks/LeftSection.astro";
import RightSection from "@/components/ui/blocks/RightSection.astro";

const pageTitle: string = `Services | ${SITE.title}`;
---

<MainLayout
  title={pageTitle}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://narvi-ec.com/services",
    url: "https://narvi-ec.com/services",
    name: "Services | NARVI",
    description: "Innovative solutions for sustainable business growth.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://narvi-ec.com",
      name: "NARVI",
      description:
        "NARVI provides engineering and maintenance services throughout the Americas, optimizing operations in the energy sector.",
    },
    inLanguage: "en-US",
  }}
>
  <MainSection
    label="Services"
    title="Advanced well intervention and production services"
    backgroundImg="/img/productos-servicios2.avif"
  />

  <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
    <!-- NARVI'S COMMITMENT TO OPERATIONAL EFFICIENCY (HIGHLIGHT CONTAINER FROM SKETCH) -->
    <section
      class="glass-card border-primary-800/40 relative mt-14 overflow-hidden rounded-3xl border p-8 shadow-2xl sm:p-10"
    >
      <div
        class="bg-primary-400/10 pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full blur-3xl"
      >
      </div>
      <div
        class="from-primary-400 to-emerald-600 absolute left-0 top-0 h-full w-2 bg-gradient-to-b"
      >
      </div>

      <div
        class="border-neutral-800/80 mb-8 flex flex-col justify-between gap-4 border-b pb-6 md:flex-row md:items-center"
      >
        <div>
          <span
            class="text-primary-400 mb-1 block text-xs font-extrabold uppercase tracking-widest"
            >ADDED VALUE</span
          >
          <h2
            class="flex items-center gap-3 text-3xl font-black text-white md:text-4xl md:leading-tight"
          >
            <span class="material-symbols-outlined text-primary-400 text-xl">task_alt</span>
            NARVI's commitment to operational efficiency
          </h2>
        </div>
        <div class="shrink-0">
          <span
            class="bg-neutral-900 border-primary-400/30 text-primary-400 rounded-full border px-3.5 py-1.5 text-xs font-bold"
          >
            Certified Standards
          </span>
        </div>
      </div>

      <!-- 4 FEATURE CARDS FROM SKETCH -->
      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        <!-- FEATURE 1 -->
        <div
          class="bg-neutral-950/90 border-neutral-800 hover:border-primary-400/50 group flex flex-col justify-between rounded-2xl border p-5 transition-all duration-300"
        >
          <div>
            <div class="mb-4 flex items-center gap-3">
              <div
                class="bg-neutral-900 border-primary-400/30 text-primary-400 group-hover:bg-primary-400 group-hover:text-white flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border text-xl shadow-md transition-all"
              >
                <span class="material-symbols-outlined">local_shipping</span>
              </div>
              <h3
                class="group-hover:text-primary-400 text-base font-bold text-white transition-colors md:text-lg"
              >
                Specialized Fleet and Equipment
              </h3>
            </div>
            <p class="text-pearl-100/85 text-sm md:text-base leading-relaxed">
              Hot pumping, cold pumping, and well stimulation with high-capacity
              operational units and continuous preventive maintenance.
            </p>
          </div>
          <div
            class="border-neutral-800/50 text-primary-400 mt-4 flex items-center justify-between border-t pt-3 text-[10px] font-bold uppercase tracking-wider"
          >
            <span>Field Operations</span>
            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          </div>
        </div>

        <!-- FEATURE 2 -->
        <div
          class="bg-neutral-950/90 border-neutral-800 hover:border-primary-400/50 group flex flex-col justify-between rounded-2xl border p-5 transition-all duration-300"
        >
          <div>
            <div class="mb-4 flex items-center gap-3">
              <div
                class="bg-neutral-900 border-primary-400/30 text-primary-400 group-hover:bg-primary-400 group-hover:text-white flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border text-xl shadow-md transition-all"
              >
                <span class="material-symbols-outlined">science</span>
              </div>
              <h3
                class="group-hover:text-primary-400 text-base font-bold text-white transition-colors md:text-lg"
              >
                In-House Laboratory
              </h3>
            </div>
            <p class="text-pearl-100/85 text-sm md:text-base leading-relaxed">
              Advanced analytical technical analysis that ensures highly
              effective interventions and precise selection of chemical
              treatments.
            </p>
          </div>
          <div
            class="border-neutral-800/50 text-primary-400 mt-4 flex items-center justify-between border-t pt-3 text-[10px] font-bold uppercase tracking-wider"
          >
            <span>Fluid Analytics</span>
            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          </div>
        </div>

        <!-- FEATURE 3 -->
        <div
          class="bg-neutral-950/90 border-neutral-800 hover:border-primary-400/50 group flex flex-col justify-between rounded-2xl border p-5 transition-all duration-300"
        >
          <div>
            <div class="mb-4 flex items-center gap-3">
              <div
                class="bg-neutral-900 border-primary-400/30 text-primary-400 group-hover:bg-primary-400 group-hover:text-white flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border text-xl shadow-md transition-all"
              >
                <span class="material-symbols-outlined">memory</span>
              </div>
              <h3
                class="group-hover:text-primary-400 text-base font-bold text-white transition-colors md:text-lg"
              >
                Technology and AI
              </h3>
            </div>
            <p class="text-pearl-100/85 text-sm md:text-base leading-relaxed">
              Real-time monitoring and control to optimize processes, predict
              pressure variations, and prevent operational deviations.
            </p>
          </div>
          <div
            class="border-neutral-800/50 text-primary-400 mt-4 flex items-center justify-between border-t pt-3 text-[10px] font-bold uppercase tracking-wider"
          >
            <span>24/7 Telemetry</span>
            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          </div>
        </div>

        <!-- FEATURE 4 -->
        <div
          class="bg-neutral-950/90 border-neutral-800 hover:border-primary-400/50 group flex flex-col justify-between rounded-2xl border p-5 transition-all duration-300"
        >
          <div>
            <div class="mb-4 flex items-center gap-3">
              <div
                class="bg-neutral-900 border-primary-400/30 text-primary-400 group-hover:bg-primary-400 group-hover:text-white flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border text-xl shadow-md transition-all"
              >
                <span class="material-symbols-outlined">shield</span>
              </div>
              <h3
                class="group-hover:text-primary-400 text-base font-bold text-white transition-colors md:text-lg"
              >
                Safety and Integrity
              </h3>
            </div>
            <p class="text-pearl-100/85 text-sm md:text-base leading-relaxed">
              Integrated management certified under the highest international
              standards for quality, environmental performance, and ISO/API
              safety.
            </p>
          </div>
          <div
            class="border-neutral-800/50 text-primary-400 mt-4 flex items-center justify-between border-t pt-3 text-[10px] font-bold uppercase tracking-wider"
          >
            <span>ISO & API Compliance</span>
            <span class="material-symbols-outlined text-[12px]">chevron_right</span>
          </div>
        </div>
      </div>
    </section>

    <RightSection
      id="bombeo-a-pozos"
      title="Oilfield services portfolio"
      subTitle="With an operational base in El Tigre, we provide technical capabilities for maintenance, intervention, and optimization of wells, with specialized equipment and personnel to execute field pumping services safely, efficiently, and aligned with each client's operational requirements."
      single={true}
      imgOne="/img/pozos.avif"
      imgOneAlt="Pumping unit in field operation"
      items={[
        "High- and low-pressure hot pumping.",
        "High- and low-pressure cold pumping.",
        "Well stimulation (organic and inorganic).",
      ]}
      btnExists={true}
      btnTitle="Contact Sales Team"
      btnURL="/contact"
    />

    <LeftSection
      id="laboratorio-in-house"
      title="In-House Laboratory"
      subTitle="Our internal laboratory is equipped with cutting-edge technology to perform fluid and chemical analysis, ensuring highly effective interventions and the precise selection of chemical treatments. With a focus on quality and efficiency, our laboratory supports field operations with reliable data and fast results."
      img="/img/laboratorio.avif"
      imgAlt="Narvi Enterprise Corporation internal laboratory"
      btnExists={true}
      btnTitle="Contact Sales Team"
      btnURL="/contact"
      items={[
        "PH determination.",
        "Total solids percentage.",
        "Clays compatibility.",
        "Water and sediment percentage measurement.",
        "Emulsion stability.",
        "Viscosity.",
        "Solubility testing.",
        "Precipitate analysis.",
        "Chemical-crude compatibility.",
      ]}
    />

    <RightSection
      id="asset-management"
      title="Asset Management"
      subTitle="Our approach ensures maximum performance and maximized value from acquisition to disposal. Through strategic planning, precise procurement, operational excellence, and continuous maintenance, we empower your assets to contribute to your success."
      single={true}
      imgOne="/img/gestion-activos.avif"
      imgOneAlt="Narvi staff conducting an asset management study"
      items={[
        "Equipment marketing",
        "Equipment maintenance",
        "Equipment commissioning",
      ]}
      btnExists={true}
      btnTitle="See Solutions"
      btnURL="/sales"
    />
  </div>
</MainLayout>
<style>
.glass-card {
    background: rgba(29, 37, 35, 0.7);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.08);
}
</style>
